modules = ["nodejs-22"]

# Dev preview: run the Astro dev server bound to Replit's proxy host/port.
run = "cd web && npm install && npm run dev -- --host 0.0.0.0 --port 5000"

[env]
HOST = "0.0.0.0"
PORT = "5000"

# Publish as a Static Deployment: build once, then serve the static output.
[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "cd web && npm ci && npm run build"]
publicDir = "web/dist"

[[ports]]
localPort = 5000
externalPort = 80
