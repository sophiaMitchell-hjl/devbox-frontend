---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getTool } from '../../lib/tools';
import { relatedTools } from '../../lib/related';
import { getClusterArticles, splitByTier, TYPE_LABEL } from '../../lib/articles';
import { cronPresets, cronFields } from '../../lib/cron';

const tool = getTool('cron')!;
const articles = await getClusterArticles('cron');
const tiers = [
  { label: '入门必看', items: splitByTier(articles).core },
  { label: '进阶 · 按需查阅', items: splitByTier(articles).advanced },
];
const title = 'Cron 表达式生成器 - 在线可视化生成、解释与执行预览 | DevBox';
const description =
  '在线 Cron 表达式生成器:可视化选择即生成 crontab,自动人话解释并预览未来执行时间。开发者/运维不用背语法,填表单直接复制,免费纯前端,还能反向验证 AI 给的表达式。';

const crumbs = [{ name: '首页', href: '/' }, { name: tool.short }];

const examples = [
  { expr: '*/5 * * * *', text: '每 5 分钟执行一次' },
  { expr: '0 * * * *', text: '每小时整点执行' },
  { expr: '0 0 * * *', text: '每天凌晨 0 点执行' },
  { expr: '0 3 * * *', text: '每天凌晨 3 点执行(常用于备份)' },
  { expr: '0 9 * * 1', text: '每周一上午 9 点执行' },
  { expr: '0 0 1 * *', text: '每月 1 号 0 点执行' },
  { expr: '0 18 * * 1-5', text: '工作日(周一至周五)18 点执行' },
  { expr: '30 2 * * 0', text: '每周日凌晨 2:30 执行' },
];

const faqs = [
  {
    q: 'Cron 表达式的五个字段分别是什么?',
    a: '从左到右依次是:分钟(0-59)、小时(0-23)、日(1-31)、月(1-12)、星期(0-6,0 表示周日)。字段之间用空格分隔。',
  },
  {
    q: 'crontab 里 * 和 */5 有什么区别?',
    a: '* 表示"每一个"(如分钟位的 * 表示每分钟);*/5 表示"每隔 5 个单位"(如分钟位的 */5 表示每 5 分钟)。',
  },
  {
    q: '星期字段 0 和 7 都表示周日吗?',
    a: '在多数实现中 0 表示周日;部分实现也接受 7 表示周日。为兼容性建议统一用 0。',
  },
  {
    q: 'AI 给我的 cron 表达式怎么确认对不对?',
    a: '把它粘贴到上面的输入框,页面会立即给出中文解释和未来 5 次执行时间——一眼就能核对是否符合预期,不用担心 AI 幻觉。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const related = relatedTools('cron');
---

<BaseLayout title={title} description={description} ogType="article">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <Breadcrumb items={crumbs} />

    <!-- 标题 + 小白导语 -->
    <header class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
        Cron 表达式生成器
      </h1>
      <div
        class="mt-4 rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900"
      >
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span
            class="rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-600 dark:bg-violet-500/10 dark:text-violet-400"
          >
            {tool.stage}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          <strong class="text-zinc-900 dark:text-white">这是什么:</strong>{tool.beginnerIntro}
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          <strong class="text-zinc-900 dark:text-white">什么时候用:</strong>{tool.whenToUse}
        </p>
      </div>
    </header>

    <!-- 工具本体 -->
    <section class="mt-8">
      <!-- 预设 -->
      <div class="mb-4 flex flex-wrap gap-2">
        {
          cronPresets.map((p) => (
            <button
              type="button"
              data-expr={p.expr}
              class="cron-preset rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm text-zinc-600 transition-colors hover:border-violet-300 hover:text-violet-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-violet-700"
            >
              {p.label}
            </button>
          ))
        }
      </div>

      <!-- 表达式输入(可粘贴 AI 输出反向验证) -->
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
        <label for="cron-expr" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
          Cron 表达式 <span class="font-normal text-zinc-400">(可直接输入或粘贴 AI 的表达式)</span>
        </label>
        <div class="flex gap-2">
          <input
            id="cron-expr"
            type="text"
            value="*/5 * * * *"
            spellcheck="false"
            autocomplete="off"
            class="flex-1 rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-lg tracking-wide text-zinc-900 outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
          />
          <button
            id="cron-copy"
            type="button"
            class="shrink-0 rounded-xl bg-zinc-900 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
          >
            复制
          </button>
        </div>

        <!-- 字段构建器 -->
        <div class="mt-4 grid grid-cols-5 gap-2">
          {
            cronFields.map((f) => (
              <div>
                <label
                  for={`cf-${f.key}`}
                  class="mb-1 block text-center text-xs font-medium text-zinc-500 dark:text-zinc-400"
                >
                  {f.label}
                </label>
                <input
                  id={`cf-${f.key}`}
                  type="text"
                  class="cron-field w-full rounded-lg border border-zinc-300 bg-white px-2 py-2 text-center font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
                />
                <p class="mt-1 text-center text-[10px] text-zinc-400">{f.hint}</p>
              </div>
            ))
          }
        </div>

        <!-- 错误 -->
        <p id="cron-error" class="mt-4 hidden text-sm text-red-500"></p>

        <!-- 解释 -->
        <div id="cron-explain-wrap" class="mt-5 rounded-xl bg-violet-50 p-4 dark:bg-violet-500/10">
          <p class="text-xs font-medium text-violet-500">这条表达式的意思</p>
          <p id="cron-explain" class="mt-1 text-base font-medium text-zinc-900 dark:text-white"></p>
        </div>

        <!-- 下次执行 -->
        <div class="mt-4">
          <p class="mb-2 text-xs font-medium text-zinc-500 dark:text-zinc-400">未来 5 次执行时间(本地时区)</p>
          <ul id="cron-next" class="space-y-1.5 font-mono text-sm text-zinc-700 dark:text-zinc-300"></ul>
        </div>
      </div>

      <p class="mt-3 text-center text-xs text-zinc-400">
        全部在你的浏览器本地计算,不上传任何数据。
      </p>
    </section>

    <!-- 生成之后怎么用 -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">生成之后,把它放到哪里?</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        Cron 表达式只描述<strong class="text-zinc-800 dark:text-zinc-200">"什么时候"</strong>,真正执行的是一条<strong
          class="text-zinc-800 dark:text-zinc-200">命令</strong>。把两者拼成一行,放进对应系统的定时任务即可。
        下面的示例会<strong class="text-violet-600 dark:text-violet-400">随上方表达式实时更新</strong>。
      </p>

      <!-- 1. Linux/macOS crontab -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">1</span>
          Linux / macOS:crontab(最常用)
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          在服务器上定时跑脚本就用它。先填你要执行的命令,得到"表达式 + 命令"这一整行:
        </p>
        <div class="mt-3">
          <label for="cron-cmd" class="mb-1 block text-xs font-medium text-zinc-500 dark:text-zinc-400">你要执行的命令</label>
          <input
            id="cron-cmd"
            type="text"
            value="/path/to/your-script.sh"
            spellcheck="false"
            autocomplete="off"
            class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
          />
          <div class="relative mt-2">
            <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="crontab-line"></code></pre>
            <button data-copy-el="crontab-line" type="button" class="copy-mini">复制</button>
          </div>
        </div>
        <ol class="mt-4 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li>1. 终端执行 <code class="inline-code">crontab -e</code>,打开当前用户的定时任务</li>
          <li>2. 把上面这一整行粘进去</li>
          <li>3. 保存退出(vim 里按 <code class="inline-code">Esc</code>,输入 <code class="inline-code">:wq</code> 回车)</li>
          <li>4. 用 <code class="inline-code">crontab -l</code> 查看已添加的任务</li>
        </ol>
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/5 dark:text-amber-300">
          💡 小贴士:cron 环境的 PATH 很精简,命令尽量用<strong>绝对路径</strong>(如 <code class="inline-code">/usr/bin/python3</code>);
          建议把输出写进日志便于排查,在命令末尾加 <code class="inline-code">&gt;&gt; /var/log/mytask.log 2&gt;&amp;1</code>。
        </div>
      </div>

      <!-- 2. 系统级 -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">2</span>
          系统级:/etc/cron.d(多一个"用户"字段)
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          写进 <code class="inline-code">/etc/crontab</code> 或 <code class="inline-code">/etc/cron.d/</code> 下的文件时,要比用户 crontab 多一个"以哪个用户运行"的字段(需要 root):
        </p>
        <div class="relative mt-3">
          <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="crontab-system"></code></pre>
          <button data-copy-el="crontab-system" type="button" class="copy-mini">复制</button>
        </div>
      </div>

      <!-- 3. Windows -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">3</span>
          Windows:没有 cron,用「任务计划程序」
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          Windows 不支持 cron 语法,三种等价做法:
        </p>
        <ul class="mt-3 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li>• <strong class="text-zinc-800 dark:text-zinc-200">图形界面</strong>:开始菜单搜索「任务计划程序 / Task Scheduler」,新建任务并设定触发时间。</li>
          <li>• <strong class="text-zinc-800 dark:text-zinc-200">命令行 schtasks</strong>,例如"每天 03:00 运行":</li>
        </ul>
        <div class="relative mt-2">
          <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-schtasks">schtasks /create /tn "MyTask" /tr "C:\path\script.bat" /sc daily /st 03:00</code></pre>
          <button data-copy-el="snip-schtasks" type="button" class="copy-mini">复制</button>
        </div>
        <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
          • 或安装 <strong class="text-zinc-800 dark:text-zinc-200">WSL</strong>(Windows 里的 Linux),就能直接用上面的 crontab。
        </p>
        <p class="mt-2 text-xs text-zinc-400">
          注意:schtasks 用自己的参数(<code class="inline-code">/sc daily</code>、<code class="inline-code">/sc hourly</code>…),不吃 cron 表达式;复杂调度建议用 WSL + crontab。
        </p>
      </div>

      <!-- 4. 代码/CI -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">4</span>
          在代码或 CI 里(直接复用这条表达式)
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          很多框架直接接受 cron 表达式,把上方生成的表达式粘进去即可:
        </p>
        <div class="mt-3 space-y-3">
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Node.js(node-cron)</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-node">cron.schedule('<span class="cron-expr-out"></span>', () =&gt; { /* 你的任务 */ })</code></pre>
              <button data-copy-el="snip-node" type="button" class="copy-mini">复制</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Python(APScheduler)</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-py">CronTrigger.from_crontab('<span class="cron-expr-out"></span>')</code></pre>
              <button data-copy-el="snip-py" type="button" class="copy-mini">复制</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Spring(注意是 6 位,秒在最前,已自动补 0)</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-spring">@Scheduled(cron = "<span class="cron-expr-spring"></span>")</code></pre>
              <button data-copy-el="snip-spring" type="button" class="copy-mini">复制</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">GitHub Actions</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-gha">on:
  schedule:
    - cron: '<span class="cron-expr-out"></span>'</code></pre>
              <button data-copy-el="snip-gha" type="button" class="copy-mini">复制</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Kubernetes CronJob</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-k8s">schedule: "<span class="cron-expr-out"></span>"</code></pre>
              <button data-copy-el="snip-k8s" type="button" class="copy-mini">复制</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 常见示例 -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">常见 Cron 表达式示例</h2>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">点击任意一行即可填入上方工具查看解释与执行时间。</p>
      <div class="mt-4 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800">
        <table class="w-full text-sm">
          <thead class="bg-zinc-50 text-left text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
            <tr>
              <th class="px-4 py-3 font-medium">表达式</th>
              <th class="px-4 py-3 font-medium">含义</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {
              examples.map((e) => (
                <tr
                  class="cron-preset cursor-pointer bg-white transition-colors hover:bg-violet-50 dark:bg-zinc-950 dark:hover:bg-violet-500/5"
                  data-expr={e.expr}
                >
                  <td class="px-4 py-3 font-mono text-violet-600 dark:text-violet-400">{e.expr}</td>
                  <td class="px-4 py-3 text-zinc-600 dark:text-zinc-300">{e.text}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">常见问题</h2>
      <div class="mt-4 space-y-3">
        {
          faqs.map((f) => (
            <details class="group rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <summary class="cursor-pointer list-none font-medium text-zinc-800 marker:content-none dark:text-zinc-100">
                <h3 class="inline">{f.q}</h3>
              </summary>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 深入了解 -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">深入了解 Cron</h2>
      <div class="mt-4 space-y-6">
        {
          tiers.map(
            (g) =>
              g.items.length > 0 && (
                <div>
                  <p class="text-xs font-medium uppercase tracking-wide text-zinc-400">{g.label}</p>
                  <div class="mt-2 grid gap-3 sm:grid-cols-2">
                    {g.items.map((a) => (
                      <a
                        href={`/cron/${a.slug}`}
                        class="rounded-xl border border-zinc-200 bg-white p-4 transition-colors hover:border-violet-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
                      >
                        <span class="text-xs text-violet-500">{TYPE_LABEL[a.type] ?? a.type}</span>
                        <span class="mt-1 block font-medium text-zinc-900 dark:text-white">{a.title}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )
          )
        }
      </div>
    </section>

    <!-- 相关工具 -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">相关工具</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          related.map((t) => (
            <a
              href={t.status === 'live' ? `/${t.slug}` : '#'}
              class="rounded-xl border border-zinc-200 bg-white p-4 text-sm transition-colors hover:border-violet-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
            >
              <span class="font-medium text-zinc-900 dark:text-white">{t.short}</span>
              <span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400">{t.desc}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <script>
    import { evaluateCron, formatDate } from '../../lib/cron';

    const exprInput = document.getElementById('cron-expr') as HTMLInputElement;
    const explainEl = document.getElementById('cron-explain')!;
    const explainWrap = document.getElementById('cron-explain-wrap')!;
    const nextEl = document.getElementById('cron-next')!;
    const errorEl = document.getElementById('cron-error')!;
    const copyBtn = document.getElementById('cron-copy') as HTMLButtonElement;
    const fieldKeys = ['min', 'hour', 'dom', 'month', 'dow'];
    const fieldInputs = fieldKeys.map(
      (k) => document.getElementById('cf-' + k) as HTMLInputElement
    );

    // "生成之后怎么用" 区块的实时联动
    const cmdInput = document.getElementById('cron-cmd') as HTMLInputElement | null;
    const crontabLine = document.getElementById('crontab-line');
    const crontabSystem = document.getElementById('crontab-system');
    const exprOuts = document.querySelectorAll<HTMLElement>('.cron-expr-out');
    const exprSpring = document.querySelectorAll<HTMLElement>('.cron-expr-spring');

    function updateUsage(expr: string) {
      const cmd = (cmdInput?.value.trim() || '/path/to/your-script.sh');
      if (crontabLine) crontabLine.textContent = `${expr} ${cmd}`;
      if (crontabSystem) crontabSystem.textContent = `${expr} root ${cmd}`;
      exprOuts.forEach((el) => (el.textContent = expr));
      exprSpring.forEach((el) => (el.textContent = `0 ${expr}`));
    }

    function syncFieldsFromExpr(expr: string) {
      const parts = expr.trim().split(/\s+/);
      if (parts.length === 5) parts.forEach((p, i) => (fieldInputs[i].value = p));
    }

    function exprFromFields() {
      return fieldInputs.map((f) => (f.value.trim() || '*')).join(' ');
    }

    function render(expr: string) {
      const res = evaluateCron(expr);
      if (res.explanation) {
        explainEl.textContent = res.explanation;
        explainWrap.classList.remove('opacity-40');
      } else {
        explainEl.textContent = '—';
        explainWrap.classList.add('opacity-40');
      }
      if (res.error) {
        errorEl.textContent = res.error;
        errorEl.classList.remove('hidden');
      } else {
        errorEl.classList.add('hidden');
      }
      if (res.ok && res.nextRuns) {
        nextEl.innerHTML = res.nextRuns
          .map(
            (d) =>
              `<li class="flex items-center gap-2"><span class="inline-block h-1.5 w-1.5 rounded-full bg-violet-400"></span>${formatDate(
                d
              )}</li>`
          )
          .join('');
      } else {
        nextEl.innerHTML = '';
      }
      updateUsage(res.expression || expr.trim().replace(/\s+/g, ' '));
    }

    cmdInput?.addEventListener('input', () => updateUsage(exprInput.value.trim().replace(/\s+/g, ' ')));

    // 直接编辑/粘贴表达式 -> 同步字段 + 渲染
    exprInput.addEventListener('input', () => {
      syncFieldsFromExpr(exprInput.value);
      render(exprInput.value);
    });

    // 编辑字段 -> 重建表达式 + 渲染
    fieldInputs.forEach((f) =>
      f.addEventListener('input', () => {
        const expr = exprFromFields();
        exprInput.value = expr;
        render(expr);
      })
    );

    // 预设 / 示例行
    document.querySelectorAll<HTMLElement>('.cron-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expr = btn.dataset.expr!;
        exprInput.value = expr;
        syncFieldsFromExpr(expr);
        render(expr);
        exprInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    // 复制表达式
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(exprInput.value);
      const old = copyBtn.textContent;
      copyBtn.textContent = '已复制';
      setTimeout(() => (copyBtn.textContent = old), 1500);
    });

    // 通用:复制代码块([data-copy-el] -> 目标元素文本)
    document.querySelectorAll<HTMLButtonElement>('[data-copy-el]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const el = document.getElementById(btn.dataset.copyEl!);
        if (!el) return;
        await navigator.clipboard.writeText(el.innerText);
        const old = btn.textContent;
        btn.textContent = '已复制';
        setTimeout(() => (btn.textContent = old), 1500);
      });
    });

    // 初始化
    syncFieldsFromExpr(exprInput.value);
    render(exprInput.value);
  </script>
</BaseLayout>
