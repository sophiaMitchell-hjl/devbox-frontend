---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = 'URL 编码 / 解码 - 在线百分号编码转换 | DevBox';
const description =
  '在线 URL 编码与解码(百分号编码),支持中文与特殊字符,可选"整段 URL"或"单个参数"两种模式,即时转换、可复制。';
const faqs = [
  {
    q: 'encodeURI 和 encodeURIComponent 有什么区别?',
    a: 'encodeURI 用于整段 URL,会保留 :/?#& 等结构字符;encodeURIComponent 用于单个参数值,会把这些字符也编码。放参数值用后者,处理整条链接用前者。',
  },
];
const areaCls =
  'w-full h-36 rounded-xl border border-zinc-300 bg-zinc-50 p-4 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="url-encode" title={title} description={description} faqs={faqs}>
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <div class="inline-flex rounded-xl border border-zinc-200 bg-zinc-100 p-1 dark:border-zinc-800 dark:bg-zinc-900">
      <button data-mode="encode" class="seg-btn rounded-lg px-4 py-1.5 text-sm font-medium">编码</button>
      <button data-mode="decode" class="seg-btn rounded-lg px-4 py-1.5 text-sm font-medium">解码</button>
    </div>
    <label class="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300">
      <input id="whole" type="checkbox" class="h-4 w-4 rounded border-zinc-300 accent-violet-600" />
      整段 URL(保留 : / ? # 等)
    </label>
  </div>

  <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">输入</label>
  <textarea id="in" class={areaCls} data-clear-target="out" placeholder="示例输入:hello world 中文" spellcheck="false"></textarea>

  <div class="mt-4 mb-1 flex items-center justify-between">
    <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">输出</label>
    <button id="copy" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">复制</button>
  </div>
  <textarea id="out" class={areaCls} readonly placeholder="示例输出:hello%20world%20%E4%B8%AD%E6%96%87"></textarea>
  <p id="err" class="mt-2 hidden text-sm text-red-500"></p>

  <script>
    let mode: 'encode' | 'decode' = 'encode';
    const inEl = document.getElementById('in') as HTMLTextAreaElement;
    const outEl = document.getElementById('out') as HTMLTextAreaElement;
    const errEl = document.getElementById('err')!;
    const whole = document.getElementById('whole') as HTMLInputElement;
    const segs = document.querySelectorAll<HTMLButtonElement>('.seg-btn');

    function run() {
      const v = inEl.value;
      errEl.classList.add('hidden');
      if (!v) {
        outEl.value = '';
        return;
      }
      try {
        if (mode === 'encode') {
          outEl.value = whole.checked ? encodeURI(v) : encodeURIComponent(v);
        } else {
          outEl.value = decodeURIComponent(v.replace(/\+/g, '%20'));
        }
      } catch {
        outEl.value = '';
        errEl.textContent = '解码失败:输入包含无效的百分号编码';
        errEl.classList.remove('hidden');
      }
    }

    function setMode(m: 'encode' | 'decode') {
      mode = m;
      segs.forEach((b) => {
        const active = b.dataset.mode === m;
        b.classList.toggle('bg-white', active);
        b.classList.toggle('text-violet-600', active);
        b.classList.toggle('shadow-sm', active);
        b.classList.toggle('dark:bg-zinc-800', active);
        b.classList.toggle('text-zinc-500', !active);
      });
      run();
    }

    segs.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as 'encode' | 'decode')));
    inEl.addEventListener('input', run);
    whole.addEventListener('change', run);
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(outEl.value);
    });
    setMode('encode');
  </script>
</ToolPageLayout>
