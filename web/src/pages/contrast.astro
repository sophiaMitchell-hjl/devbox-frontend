---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = '颜色对比度检测 - WCAG 可读性(AA/AAA)| DevBox';
const description =
  '在线颜色对比度检测:输入文字色与背景色,计算对比度并按 WCAG 判断是否达到 AA/AAA 标准,实时预览。浏览器本地计算。';
const faqs = [
  {
    q: 'AA 和 AAA 是什么标准?',
    a: 'WCAG 无障碍标准:正常文字对比度 ≥4.5 为 AA、≥7 为 AAA;大号文字(≥18.66px 粗体或 24px)阈值分别为 3 和 4.5。',
  },
];
---

<ToolPageLayout slug="contrast" title={title} description={description} faqs={faqs}>
  <div class="grid gap-6 md:grid-cols-2">
    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <input id="fg" type="color" value="#333333" class="h-11 w-16 cursor-pointer rounded border border-zinc-300 bg-transparent dark:border-zinc-700" />
        <span class="text-sm text-zinc-600 dark:text-zinc-300">文字色</span>
      </div>
      <div class="flex items-center gap-3">
        <input id="bg" type="color" value="#ffffff" class="h-11 w-16 cursor-pointer rounded border border-zinc-300 bg-transparent dark:border-zinc-700" />
        <span class="text-sm text-zinc-600 dark:text-zinc-300">背景色</span>
      </div>
      <div id="preview" class="rounded-xl border border-zinc-200 p-6 dark:border-zinc-800">
        <p class="text-2xl font-bold">大号文字 Aa</p>
        <p class="text-sm">正常大小的示例文字 The quick brown fox.</p>
      </div>
    </div>
    <div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 text-center dark:border-zinc-800 dark:bg-zinc-900">
        <p class="text-sm text-zinc-400">对比度</p>
        <p id="ratio" class="font-mono text-4xl font-bold text-zinc-900 dark:text-white"></p>
      </div>
      <div id="grades" class="mt-4 space-y-2 text-sm"></div>
    </div>
  </div>

  <script>
    const fg = document.getElementById('fg') as HTMLInputElement;
    const bg = document.getElementById('bg') as HTMLInputElement;
    const preview = document.getElementById('preview')!;
    const ratioEl = document.getElementById('ratio')!;
    const grades = document.getElementById('grades')!;

    function lum(hex: string) {
      const m = hex.replace('#', '');
      const c = [0, 2, 4].map((i) => {
        let v = parseInt(m.slice(i, i + 2), 16) / 255;
        return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      });
      return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
    }
    function badge(pass: boolean, label: string) {
      return `<div class="flex items-center justify-between rounded-lg border px-3 py-2 ${pass ? 'border-emerald-200 bg-emerald-50 dark:border-emerald-500/25 dark:bg-emerald-500/5' : 'border-red-200 bg-red-50 dark:border-red-500/25 dark:bg-red-500/5'}"><span class="text-zinc-600 dark:text-zinc-300">${label}</span><span class="${pass ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-500'} font-medium">${pass ? '通过 ✓' : '不通过 ✗'}</span></div>`;
    }

    function run() {
      const l1 = lum(fg.value), l2 = lum(bg.value);
      const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
      preview.style.color = fg.value;
      preview.style.background = bg.value;
      ratioEl.textContent = ratio.toFixed(2) + ':1';
      grades.innerHTML =
        badge(ratio >= 4.5, '正常文字 AA (≥4.5)') +
        badge(ratio >= 7, '正常文字 AAA (≥7)') +
        badge(ratio >= 3, '大号文字 AA (≥3)') +
        badge(ratio >= 4.5, '大号文字 AAA (≥4.5)');
    }
    fg.addEventListener('input', run);
    bg.addEventListener('input', run);
    run();
  </script>
</ToolPageLayout>
