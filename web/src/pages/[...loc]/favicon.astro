---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: 'Favicon 生成器 - 上传图片生成多尺寸网站图标 | DevBox',
    description:
      '在线 Favicon 生成:上传一张图片,本地生成 16/32/48/180/192/512 等尺寸 PNG 图标,并给出 HTML 引用代码。图片不上传服务器。',
    selectLabel: '选择图片(建议正方形,PNG/JPG/SVG)',
    codeLabel: 'HTML 引用代码',
    copy: '复制',
    faqs: [
      {
        q: '为什么不是 .ico 文件?',
        a: '现代浏览器普遍支持 PNG favicon,直接用多尺寸 PNG + link 标签即可,兼容性好且清晰。老旧环境如仍需 .ico,可另行转换。',
      },
    ],
  },
  en: {
    title: 'Favicon Generator - Upload an Image to Make Multi-Size Site Icons | DevBox',
    description:
      'Online favicon generator: upload one image and locally generate 16/32/48/180/192/512 PNG icons, with the HTML reference code. Images are never uploaded to a server.',
    selectLabel: 'Choose an image (square recommended, PNG/JPG/SVG)',
    codeLabel: 'HTML reference code',
    copy: 'Copy',
    faqs: [
      {
        q: 'Why not a .ico file?',
        a: 'Modern browsers widely support PNG favicons, so multi-size PNGs plus link tags work well — good compatibility and crisp rendering. If a legacy environment still needs .ico, convert it separately.',
      },
    ],
  },
}[lang];

const sizes = [16, 32, 48, 180, 192, 512];
---

<ToolPageLayout slug="favicon" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.selectLabel}</label>
    <input id="file" type="file" accept="image/*" class="text-sm text-zinc-600 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-900 file:px-4 file:py-2 file:text-white dark:text-zinc-300 dark:file:bg-white dark:file:text-zinc-900" />

    <div id="result" class="mt-6 hidden">
      <div id="icons" class="flex flex-wrap items-end gap-5"></div>
      <div class="mt-6">
        <div class="mb-1 flex items-center justify-between">
          <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.codeLabel}</span>
          <button id="copy" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copy}</button>
        </div>
        <pre class="rounded-xl bg-zinc-900 p-4 font-mono text-xs whitespace-pre-wrap break-words text-zinc-100"><code id="code"></code></pre>
      </div>
    </div>
  </div>

  <script>
    const sizes = [16, 32, 48, 180, 192, 512];
    const fileEl = document.getElementById('file') as HTMLInputElement;
    const result = document.getElementById('result')!;
    const icons = document.getElementById('icons')!;
    const code = document.getElementById('code')!;

    fileEl.addEventListener('change', () => {
      const f = fileEl.files?.[0];
      if (!f) return;
      const im = new Image();
      im.onload = () => {
        icons.innerHTML = '';
        for (const s of sizes) {
          const c = document.createElement('canvas');
          c.width = c.height = s;
          c.getContext('2d')!.drawImage(im, 0, 0, s, s);
          const url = c.toDataURL('image/png');
          const wrap = document.createElement('div');
          wrap.className = 'text-center';
          wrap.innerHTML = `<img src="${url}" width="${Math.min(s, 64)}" height="${Math.min(s, 64)}" class="rounded border border-zinc-200 dark:border-zinc-800" alt="${s}" /><a href="${url}" download="favicon-${s}.png" class="mt-1 block text-xs text-violet-600 dark:text-violet-400">${s}px ↓</a>`;
          icons.appendChild(wrap);
        }
        code.textContent = [
          '<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">',
          '<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">',
          '<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png">',
          '<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">',
        ].join('\n');
        result.classList.remove('hidden');
      };
      im.src = URL.createObjectURL(f);
    });

    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(code.textContent || '');
    });
  </script>
</ToolPageLayout>
