---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: '图片压缩 - 本地压缩 JPG/PNG/WebP,不上传 | DevBox',
    description:
      '在线图片压缩:在浏览器本地压缩 JPG/PNG/WebP,可调质量与最大宽度,实时显示压缩前后大小,图片不上传服务器,隐私安全。',
    selectLabel: '选择图片',
    qualityLabel: '质量',
    maxwLabel: '最大宽度(px,留空不缩)',
    maxwPlaceholder: '如 1920',
    formatLabel: '格式',
    origLabel: '原图',
    compressedLabel: '压缩后',
    previewAlt: '压缩预览',
    download: '下载压缩后的图片',
    faqs: [
      {
        q: '图片会上传到服务器吗?',
        a: '不会。压缩全程在你的浏览器本地用 Canvas 完成,图片不离开你的设备,适合处理敏感图片。',
      },
      {
        q: '为什么 PNG 压缩效果不如 JPG?',
        a: 'JPG/WebP 是有损压缩,能大幅减小体积;PNG 无损、更适合图标与透明图。照片类建议转成 JPG 或 WebP 压缩效果更好。',
      },
    ],
  },
  en: {
    title: 'Image Compressor - Compress JPG/PNG/WebP Locally, No Upload | DevBox',
    description:
      'Online image compressor: compress JPG/PNG/WebP locally in your browser with adjustable quality and max width, showing before/after size in real time. Images never leave your device — privacy-safe.',
    selectLabel: 'Choose an image',
    qualityLabel: 'Quality',
    maxwLabel: 'Max width (px, leave empty to keep)',
    maxwPlaceholder: 'e.g. 1920',
    formatLabel: 'Format',
    origLabel: 'Original',
    compressedLabel: 'Compressed',
    previewAlt: 'Compression preview',
    download: 'Download compressed image',
    faqs: [
      {
        q: 'Are images uploaded to a server?',
        a: 'No. Compression runs entirely in your browser via Canvas, so images never leave your device — great for sensitive images.',
      },
      {
        q: 'Why does PNG compress worse than JPG?',
        a: 'JPG/WebP are lossy and can shrink files dramatically; PNG is lossless and better suited to icons and transparent images. For photos, convert to JPG or WebP for better compression.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout slug="image-compress" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="flex flex-wrap items-end gap-5">
      <div>
        <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.selectLabel}</label>
        <input id="file" type="file" accept="image/*" class="text-sm text-zinc-600 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-900 file:px-4 file:py-2 file:text-white dark:text-zinc-300 dark:file:bg-white dark:file:text-zinc-900" />
      </div>
      <div>
        <label class="mb-1 flex items-center justify-between text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.qualityLabel} <span id="q-val" class="ml-3 font-mono text-zinc-400">0.8</span></label>
        <input id="quality" type="range" min="0.1" max="1" step="0.05" value="0.8" class="accent-violet-600" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.maxwLabel}</label>
        <input id="maxw" type="number" placeholder={copy.maxwPlaceholder} class="w-32 rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" />
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.formatLabel}</label>
        <select id="format" class="rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm dark:border-zinc-700 dark:bg-zinc-950 dark:text-white">
          <option value="image/jpeg">JPG</option>
          <option value="image/webp">WebP</option>
          <option value="image/png">PNG</option>
        </select>
      </div>
    </div>

    <div id="result" class="mt-6 hidden">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-zinc-200 p-3 text-center dark:border-zinc-800">
          <p class="text-xs text-zinc-400">{copy.origLabel}</p>
          <p id="orig-size" class="font-mono text-lg font-semibold text-zinc-800 dark:text-zinc-100"></p>
        </div>
        <div class="rounded-xl border border-violet-200 bg-violet-50 p-3 text-center dark:border-violet-500/25 dark:bg-violet-500/5">
          <p class="text-xs text-violet-500">{copy.compressedLabel} <span id="ratio"></span></p>
          <p id="new-size" class="font-mono text-lg font-semibold text-violet-700 dark:text-violet-300"></p>
        </div>
      </div>
      <img id="preview" class="mt-4 max-h-80 w-full rounded-xl border border-zinc-200 object-contain dark:border-zinc-800" alt={copy.previewAlt} />
      <a id="download" class="mt-4 inline-block rounded-lg bg-zinc-900 px-5 py-2 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200" download>{copy.download}</a>
    </div>
  </div>

  <script>
    const fileEl = document.getElementById('file') as HTMLInputElement;
    const quality = document.getElementById('quality') as HTMLInputElement;
    const qVal = document.getElementById('q-val')!;
    const maxw = document.getElementById('maxw') as HTMLInputElement;
    const format = document.getElementById('format') as HTMLSelectElement;
    const result = document.getElementById('result')!;
    const origSize = document.getElementById('orig-size')!;
    const newSize = document.getElementById('new-size')!;
    const ratio = document.getElementById('ratio')!;
    const preview = document.getElementById('preview') as HTMLImageElement;
    const download = document.getElementById('download') as HTMLAnchorElement;

    let img: HTMLImageElement | null = null;
    let origBytes = 0;

    const fmtSize = (b: number) => (b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : (b / 1048576).toFixed(2) + ' MB');

    fileEl.addEventListener('change', () => {
      const f = fileEl.files?.[0];
      if (!f) return;
      origBytes = f.size;
      const url = URL.createObjectURL(f);
      const im = new Image();
      im.onload = () => {
        img = im;
        process();
      };
      im.src = url;
    });

    function process() {
      if (!img) return;
      let w = img.naturalWidth;
      let h = img.naturalHeight;
      const mw = Number(maxw.value);
      if (mw && w > mw) {
        h = Math.round((h * mw) / w);
        w = mw;
      }
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d')!;
      ctx.drawImage(img, 0, 0, w, h);
      const mime = format.value;
      canvas.toBlob(
        (blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          preview.src = url;
          origSize.textContent = fmtSize(origBytes);
          newSize.textContent = fmtSize(blob.size);
          const pct = Math.round((1 - blob.size / origBytes) * 100);
          ratio.textContent = pct > 0 ? `↓ ${pct}%` : '';
          const ext = mime === 'image/jpeg' ? 'jpg' : mime === 'image/webp' ? 'webp' : 'png';
          download.href = url;
          download.download = `compressed.${ext}`;
          result.classList.remove('hidden');
        },
        mime,
        Number(quality.value)
      );
    }

    quality.addEventListener('input', () => {
      qVal.textContent = quality.value;
      process();
    });
    maxw.addEventListener('input', process);
    format.addEventListener('change', process);
  </script>
</ToolPageLayout>
