---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: 'Docker Compose 模板生成器 - 挑服务拼 compose 文件 | DevBox',
    description:
      '在线 Docker Compose 生成器:勾选 App、PostgreSQL、MySQL、Redis、MongoDB、Nginx 等服务,即出带卷、健康检查、依赖的 docker-compose.yml,复制即用。',
    faqs: [
      {
        q: '生成的 compose 文件怎么用?',
        a: '保存为 docker-compose.yml,在同目录执行 docker compose up -d 即可后台启动全部服务;docker compose ps 查看状态,docker compose down 停止。',
      },
      {
        q: '密码等敏感信息怎么处理?',
        a: '模板里的 change-me 只是占位,请改成强密码,或用 .env 文件与 environment 变量引用,避免明文提交到仓库。',
      },
    ],
    appName: 'App(你的应用)',
    selectServices: '选择服务',
    restart: '重启策略',
    restartRecommended: 'unless-stopped(推荐)',
    copy: '复制',
  },
  en: {
    title: 'Docker Compose Template Generator - Pick Services, Build a Compose File | DevBox',
    description:
      'Online Docker Compose generator: tick App, PostgreSQL, MySQL, Redis, MongoDB, Nginx and more to get a docker-compose.yml with volumes, health checks and dependencies — ready to copy.',
    faqs: [
      {
        q: 'How do I use the generated compose file?',
        a: 'Save it as docker-compose.yml and run docker compose up -d in the same directory to start all services in the background; docker compose ps shows status, docker compose down stops them.',
      },
      {
        q: 'How should I handle passwords and other secrets?',
        a: 'The change-me values in the template are placeholders — replace them with strong passwords, or reference them from a .env file via environment variables, so secrets are not committed to the repo in plain text.',
      },
    ],
    appName: 'App (your application)',
    selectServices: 'Select services',
    restart: 'Restart policy',
    restartRecommended: 'unless-stopped (recommended)',
    copy: 'Copy',
  },
}[lang];

const services = [
  { key: 'app', name: copy.appName, def: true },
  { key: 'postgres', name: 'PostgreSQL', def: true },
  { key: 'mysql', name: 'MySQL', def: false },
  { key: 'redis', name: 'Redis', def: false },
  { key: 'mongo', name: 'MongoDB', def: false },
  { key: 'nginx', name: 'Nginx', def: false },
];
---

<ToolPageLayout slug="docker-compose" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="grid gap-6 md:grid-cols-2">
    <!-- form -->
    <div class="space-y-4">
      <div>
        <p class="mb-2 text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.selectServices}</p>
        <div class="grid grid-cols-2 gap-2">
          {
            services.map((s) => (
              <label class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
                <input type="checkbox" class="svc-box h-4 w-4 rounded border-zinc-300 accent-violet-600" data-svc={s.key} checked={s.def} />
                {s.name}
              </label>
            ))
          }
        </div>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.restart}</label>
        <select id="restart" class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white">
          <option value="unless-stopped">{copy.restartRecommended}</option>
          <option value="always">always</option>
          <option value="on-failure">on-failure</option>
          <option value="no">no</option>
        </select>
      </div>
    </div>

    <!-- output -->
    <div>
      <div class="mb-2 flex items-center justify-between">
        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">docker-compose.yml</span>
        <button id="copy" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copy}</button>
      </div>
      <pre class="max-h-[80vh] overflow-auto rounded-xl bg-zinc-900 p-4 font-mono text-sm whitespace-pre-wrap break-words text-zinc-100"><code id="out"></code></pre>
    </div>
  </div>

  <script>
    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      pickOne: L === 'en' ? '# Select at least one service' : '# 请至少选择一个服务',
    };
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.svc-box'));
    const restartEl = document.getElementById('restart') as HTMLSelectElement;
    const out = document.getElementById('out')!;

    function build() {
      const sel: Record<string, boolean> = {};
      boxes.forEach((b) => (sel[b.dataset.svc!] = b.checked));
      const restart = restartEl.value;
      const r = restart !== 'no' ? [`    restart: ${restart}`] : [];
      const svc: string[] = [];
      const vols: string[] = [];

      if (sel.app) {
        svc.push('  app:');
        svc.push('    build: .');
        svc.push('    # image: your-image:latest');
        svc.push(...r);
        svc.push('    ports:', '      - "3000:3000"');
        svc.push('    environment:', '      - NODE_ENV=production');
        const deps = ['postgres', 'mysql', 'redis', 'mongo'].filter((k) => sel[k]);
        if (deps.length) {
          svc.push('    depends_on:');
          deps.forEach((d) => svc.push(`      - ${d}`));
        }
      }
      if (sel.postgres) {
        svc.push('  postgres:', '    image: postgres:16', ...r);
        svc.push('    environment:', '      POSTGRES_DB: appdb', '      POSTGRES_USER: app', '      POSTGRES_PASSWORD: change-me');
        svc.push('    volumes:', '      - pgdata:/var/lib/postgresql/data');
        svc.push('    healthcheck:', '      test: ["CMD-SHELL", "pg_isready -U app"]', '      interval: 10s', '      timeout: 5s', '      retries: 5');
        vols.push('  pgdata:');
      }
      if (sel.mysql) {
        svc.push('  mysql:', '    image: mysql:8', ...r);
        svc.push('    environment:', '      MYSQL_DATABASE: appdb', '      MYSQL_USER: app', '      MYSQL_PASSWORD: change-me', '      MYSQL_ROOT_PASSWORD: change-me-root');
        svc.push('    volumes:', '      - mysqldata:/var/lib/mysql');
        svc.push('    healthcheck:', '      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]', '      interval: 10s', '      timeout: 5s', '      retries: 5');
        vols.push('  mysqldata:');
      }
      if (sel.redis) {
        svc.push('  redis:', '    image: redis:7-alpine', ...r);
        svc.push('    ports:', '      - "6379:6379"');
        svc.push('    volumes:', '      - redisdata:/data');
        vols.push('  redisdata:');
      }
      if (sel.mongo) {
        svc.push('  mongo:', '    image: mongo:7', ...r);
        svc.push('    environment:', '      MONGO_INITDB_ROOT_USERNAME: root', '      MONGO_INITDB_ROOT_PASSWORD: change-me');
        svc.push('    volumes:', '      - mongodata:/data/db');
        vols.push('  mongodata:');
      }
      if (sel.nginx) {
        svc.push('  nginx:', '    image: nginx:alpine', ...r);
        svc.push('    ports:', '      - "80:80"', '      - "443:443"');
        svc.push('    volumes:', '      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro');
        if (sel.app) svc.push('    depends_on:', '      - app');
      }

      if (!svc.length) {
        out.textContent = TXT.pickOne;
        return;
      }
      const lines = ['services:', ...svc];
      if (vols.length) lines.push('', 'volumes:', ...vols);
      out.textContent = lines.join('\n');
    }

    boxes.forEach((b) => b.addEventListener('change', build));
    restartEl.addEventListener('change', build);
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(out.textContent || '');
    });
    build();
  </script>
</ToolPageLayout>
