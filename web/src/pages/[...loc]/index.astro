---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import LifecycleFlow from '../../components/LifecycleFlow.astro';
import Chip from '../../components/Chip.astro';
import { getTools, categoryLabels } from '../../lib/tools';
import type { Category } from '../../lib/tools';
import { flowlessGroups } from '../../lib/roadmap';
import { localePaths, langOfParam, localePath } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const tools = getTools(lang);
const labels = categoryLabels(lang);
const extraGroups = flowlessGroups(lang);

// 按分类分组(用于左侧导航 + 右侧分组网格)
const CAT_ORDER: Category[] = ['config', 'dev', 'text', 'design', 'code', 'seo'];
const categories = CAT_ORDER.map((key) => ({
  key,
  label: labels[key],
  tools: tools.filter((t) => t.category === key),
})).filter((c) => c.tools.length > 0);

const copy = {
  zh: {
    title: 'DevBox - 开发者在线工具箱:配置生成 / 正则 / Cron / 命令构建',
    description:
      'DevBox 开发者在线工具箱:Nginx/Caddy 配置、Docker Compose、Cron 表达式、正则调试等,填参数即出配置与命令,复制可用,纯浏览器计算、免注册。',
    badge: '填参数,出配置与命令',
    h1a: '开发者的',
    h1b: '在线工具箱',
    lead: 'Nginx 反代、Docker Compose、Cron、正则……常用配置与命令,填表单即得,复制可用。全程浏览器本地计算,免注册、不上传。',
    ctaCron: '试试 Cron 生成器',
    ctaGuide: '不知从哪开始?看部署指南',
    subLeadStrong: '少背语法、少查文档',
    subLead: '——常用配置与命令,填一填就好,复制即走。',
    flowTitle: '按开发流程找工具',
    flowDesc: '从写代码到部署上线,每一步用得到的工具都标在流程两侧。不知道该找什么?顺着流程走就行。',
    legendLive: '已上线,点击可用',
    legendSoon: '规划中',
    moreDesc: '更多不属于单一环节的通用工具(按分类,持续上线中):',
    allTools: '全部工具',
    countSuffix: '个 · 按分类浏览',
  },
  en: {
    title: 'DevBox - Online Developer Toolbox: config generators / regex / cron / command builders',
    description:
      'DevBox online developer toolbox: Nginx/Caddy configs, Docker Compose, cron expressions, regex debugging and more. Fill in a form and get ready-to-copy configs and commands — all computed in your browser, no signup.',
    badge: 'Fill a form, get configs & commands',
    h1a: "A developer's",
    h1b: 'online toolbox',
    lead: 'Nginx reverse proxy, Docker Compose, cron, regex… common configs and commands, generated from a form and ready to copy. Everything runs locally in your browser — no signup, nothing uploaded.',
    ctaCron: 'Try the Cron generator',
    ctaGuide: "Not sure where to start? Read the deploy guide",
    subLeadStrong: 'Less syntax to memorize, fewer docs to search',
    subLead: ' — fill in the common configs and commands, then copy and go.',
    flowTitle: 'Find tools by development stage',
    flowDesc: 'From writing code to going live, the tools for each step are marked along the flow. Not sure what to look for? Just follow the flow.',
    legendLive: 'Live, click to use',
    legendSoon: 'Planned',
    moreDesc: 'More general-purpose tools that span stages (by category, shipping continuously):',
    allTools: 'All tools',
    countSuffix: 'tools · browse by category',
  },
}[lang];

const siteUrl = Astro.site!.href.replace(/\/$/, '');
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DevBox',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  description:
    lang === 'en'
      ? 'An online toolbox for developers and ops: fill in parameters to get configs and commands, all computed locally in the browser.'
      : '面向开发者与运维的在线工具箱,填参数即出配置与命令,全程浏览器本地计算。',
};
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevBox',
  url: siteUrl,
  inLanguage: lang === 'en' ? 'en' : 'zh-CN',
  publisher: { '@type': 'Organization', name: 'DevBox', url: siteUrl },
};
---

<BaseLayout title={copy.title} description={copy.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-gradient-to-tr from-indigo-500/20 via-violet-500/20 to-fuchsia-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 text-center sm:pt-28">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/60 px-4 py-1.5 text-sm text-zinc-600 backdrop-blur dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-300"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-violet-500"></span>
        {copy.badge}
      </span>
      <h1
        class="mx-auto mt-6 max-w-3xl text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl dark:text-white"
      >
        {copy.h1a}<span class="text-gradient">{copy.h1b}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        {copy.lead}
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localePath('/cron', lang)}
          class="rounded-xl bg-zinc-900 px-6 py-3 text-sm font-medium text-white shadow-lg shadow-zinc-900/10 transition-transform hover:-translate-y-0.5 dark:bg-white dark:text-zinc-900"
        >
          {copy.ctaCron}
        </a>
        <a
          href={localePath('/guide/deploy-to-server', lang)}
          class="rounded-xl border border-zinc-300 px-6 py-3 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-600"
        >
          {copy.ctaGuide}
        </a>
      </div>

      <p class="mx-auto mt-10 max-w-2xl text-sm text-zinc-500 dark:text-zinc-500">
        <span class="font-medium text-zinc-700 dark:text-zinc-300">{copy.subLeadStrong}</span
        >{copy.subLead}
      </p>
    </div>
  </section>

  <!-- 开发流程地图 -->
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-10 text-center">
      <h2 class="text-2xl font-bold text-zinc-900 sm:text-3xl dark:text-white">{copy.flowTitle}</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
        {copy.flowDesc}
      </p>
      <div class="mt-4 flex items-center justify-center gap-4 text-xs text-zinc-400">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-violet-500"></span>{copy.legendLive}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full border border-zinc-300 dark:border-zinc-600"></span>{copy.legendSoon}
        </span>
      </div>
    </div>

    <LifecycleFlow lang={lang} />

    <!-- 流程外:按分类的更多工具(规划中) -->
    <div class="mx-auto mt-16 max-w-4xl border-t border-zinc-200 pt-10 dark:border-zinc-800">
      <p class="text-center text-sm text-zinc-500 dark:text-zinc-400">
        {copy.moreDesc}
      </p>
      <div class="mt-6 space-y-6">
        {
          extraGroups.map((g) => (
            <div class="rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
              <h3 class="mb-3 text-sm font-semibold text-zinc-700 dark:text-zinc-200">{g.category}</h3>
              <div class="flex flex-wrap gap-2">
                {g.items.map((it) => (
                  <Chip item={it} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 工具列表:左分类导航 + 右分组网格 -->
  <section id="tools" class="mx-auto max-w-6xl px-6 pb-8">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{copy.allTools}</h2>
      <span class="text-sm text-zinc-400">{tools.length} {copy.countSuffix}</span>
    </div>

    <div class="flex gap-8">
      <!-- 左侧分类导航 -->
      <aside class="hidden w-44 shrink-0 lg:block">
        <nav class="sticky top-24 space-y-1">
          {
            categories.map((c) => (
              <a
                href={`#cat-${c.key}`}
                data-cat={c.key}
                class="cat-link flex items-center justify-between rounded-lg px-3 py-2 text-sm text-zinc-600 transition-colors hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800"
              >
                {c.label}
                <span class="text-xs text-zinc-400">{c.tools.length}</span>
              </a>
            ))
          }
        </nav>
      </aside>

      <!-- 右侧:按分类分组 -->
      <div class="min-w-0 flex-1 space-y-12">
        {
          categories.map((c) => (
            <section id={`cat-${c.key}`} data-cat-section={c.key} class="scroll-mt-24">
              <h3 class="mb-4 flex items-center gap-2 text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
                {c.label}
                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-normal text-zinc-400 dark:bg-zinc-800">
                  {c.tools.length}
                </span>
              </h3>
              <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                {c.tools.map((tool) => (
                  <ToolCard tool={tool} lang={lang} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    // 滚动高亮当前分类
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.cat-link'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-section]'));
    const active = 'bg-violet-50 !text-violet-700 font-medium dark:bg-violet-500/10 dark:!text-violet-300';

    function setActive(key: string | null) {
      links.forEach((l) => {
        const on = l.dataset.cat === key;
        active.split(' ').forEach((cls) => l.classList.toggle(cls, on));
      });
    }

    if ('IntersectionObserver' in window && sections.length) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible) setActive((visible.target as HTMLElement).dataset.catSection || null);
        },
        { rootMargin: '-100px 0px -60% 0px' }
      );
      sections.forEach((s) => io.observe(s));
      setActive(sections[0].dataset.catSection || null);
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
</BaseLayout>
