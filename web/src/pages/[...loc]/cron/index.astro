---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getTool } from '../../../lib/tools';
import { relatedTools } from '../../../lib/related';
import { getClusterArticles, splitByTier, TYPE_LABEL } from '../../../lib/articles';
import { getCronPresets, getCronFields } from '../../../lib/cron';
import { localePaths, langOfParam, localePath } from '../../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const tool = getTool('cron', lang)!;
const articles = await getClusterArticles('cron', lang);
const tiersData = splitByTier(articles);
const cronPresets = getCronPresets(lang);
const cronFields = getCronFields(lang);

const copy = {
  zh: {
    title: 'Cron 表达式生成器 - 在线可视化生成、解释与执行预览 | DevBox',
    description:
      '在线 Cron 表达式生成器:可视化选择即生成 crontab,自动人话解释并预览未来执行时间。开发者/运维不用背语法,填表单直接复制,免费纯前端,还能反向验证 AI 给的表达式。',
    home: '首页',
    h1: 'Cron 表达式生成器',
    whatIs: '这是什么:',
    whenUse: '什么时候用:',
    exprLabel: 'Cron 表达式',
    exprLabelHint: '(可直接输入或粘贴 AI 的表达式)',
    copyBtn: '复制',
    explainTitle: '这条表达式的意思',
    nextTitle: '未来 5 次执行时间(本地时区)',
    localNote: '全部在你的浏览器本地计算,不上传任何数据。',
    // 生成之后怎么用
    useH2: '生成之后,把它放到哪里?',
    useIntro:
      'Cron 表达式只描述<strong class="text-zinc-800 dark:text-zinc-200">"什么时候"</strong>,真正执行的是一条<strong class="text-zinc-800 dark:text-zinc-200">命令</strong>。把两者拼成一行,放进对应系统的定时任务即可。下面的示例会<strong class="text-violet-600 dark:text-violet-400">随上方表达式实时更新</strong>。',
    b1Title: 'Linux / macOS:crontab(最常用)',
    b1Desc: '在服务器上定时跑脚本就用它。先填你要执行的命令,得到"表达式 + 命令"这一整行:',
    b1CmdLabel: '你要执行的命令',
    b1Steps: [
      '1. 终端执行 <code class="inline-code">crontab -e</code>,打开当前用户的定时任务',
      '2. 把上面这一整行粘进去',
      '3. 保存退出(vim 里按 <code class="inline-code">Esc</code>,输入 <code class="inline-code">:wq</code> 回车)',
      '4. 用 <code class="inline-code">crontab -l</code> 查看已添加的任务',
    ],
    b1Tip:
      '💡 小贴士:cron 环境的 PATH 很精简,命令尽量用<strong>绝对路径</strong>(如 <code class="inline-code">/usr/bin/python3</code>);建议把输出写进日志便于排查,在命令末尾加 <code class="inline-code">&gt;&gt; /var/log/mytask.log 2&gt;&amp;1</code>。',
    b2Title: '系统级:/etc/cron.d(多一个"用户"字段)',
    b2Desc:
      '写进 <code class="inline-code">/etc/crontab</code> 或 <code class="inline-code">/etc/cron.d/</code> 下的文件时,要比用户 crontab 多一个"以哪个用户运行"的字段(需要 root):',
    b3Title: 'Windows:没有 cron,用「任务计划程序」',
    b3Desc: 'Windows 不支持 cron 语法,三种等价做法:',
    b3Li1:
      '• <strong class="text-zinc-800 dark:text-zinc-200">图形界面</strong>:开始菜单搜索「任务计划程序 / Task Scheduler」,新建任务并设定触发时间。',
    b3Li2:
      '• <strong class="text-zinc-800 dark:text-zinc-200">命令行 schtasks</strong>,例如"每天 03:00 运行":',
    b3WSL:
      '• 或安装 <strong class="text-zinc-800 dark:text-zinc-200">WSL</strong>(Windows 里的 Linux),就能直接用上面的 crontab。',
    b3Note:
      '注意:schtasks 用自己的参数(<code class="inline-code">/sc daily</code>、<code class="inline-code">/sc hourly</code>…),不吃 cron 表达式;复杂调度建议用 WSL + crontab。',
    b4Title: '在代码或 CI 里(直接复用这条表达式)',
    b4Desc: '很多框架直接接受 cron 表达式,把上方生成的表达式粘进去即可:',
    b4Spring: 'Spring(注意是 6 位,秒在最前,已自动补 0)',
    nodeComment: '你的任务',
    // 示例
    examplesH2: '常见 Cron 表达式示例',
    examplesDesc: '点击任意一行即可填入上方工具查看解释与执行时间。',
    thExpr: '表达式',
    thMeaning: '含义',
    examples: [
      { expr: '*/5 * * * *', text: '每 5 分钟执行一次' },
      { expr: '0 * * * *', text: '每小时整点执行' },
      { expr: '0 0 * * *', text: '每天凌晨 0 点执行' },
      { expr: '0 3 * * *', text: '每天凌晨 3 点执行(常用于备份)' },
      { expr: '0 9 * * 1', text: '每周一上午 9 点执行' },
      { expr: '0 0 1 * *', text: '每月 1 号 0 点执行' },
      { expr: '0 18 * * 1-5', text: '工作日(周一至周五)18 点执行' },
      { expr: '30 2 * * 0', text: '每周日凌晨 2:30 执行' },
    ],
    // FAQ
    faqH2: '常见问题',
    faqs: [
      {
        q: 'Cron 表达式的五个字段分别是什么?',
        a: '从左到右依次是:分钟(0-59)、小时(0-23)、日(1-31)、月(1-12)、星期(0-6,0 表示周日)。字段之间用空格分隔。',
      },
      {
        q: 'crontab 里 * 和 */5 有什么区别?',
        a: '* 表示"每一个"(如分钟位的 * 表示每分钟);*/5 表示"每隔 5 个单位"(如分钟位的 */5 表示每 5 分钟)。',
      },
      {
        q: '星期字段 0 和 7 都表示周日吗?',
        a: '在多数实现中 0 表示周日;部分实现也接受 7 表示周日。为兼容性建议统一用 0。',
      },
      {
        q: 'AI 给我的 cron 表达式怎么确认对不对?',
        a: '把它粘贴到上面的输入框,页面会立即给出中文解释和未来 5 次执行时间——一眼就能核对是否符合预期,不用担心 AI 幻觉。',
      },
    ],
    // 深入了解 / 相关
    deepH2: '深入了解 Cron',
    tierCore: '入门必看',
    tierAdvanced: '进阶 · 按需查阅',
    relatedH2: '相关工具',
  },
  en: {
    title: 'Cron Expression Generator - Visual builder, plain-English explainer & run preview | DevBox',
    description:
      'Online cron expression generator: build a crontab visually, get an automatic plain-English explanation, and preview upcoming run times. No need to memorize the syntax — fill in a form and copy, free and fully client-side. You can also paste an AI-generated expression to verify it.',
    home: 'Home',
    h1: 'Cron Expression Generator',
    whatIs: 'What it is: ',
    whenUse: 'When to use: ',
    exprLabel: 'Cron expression',
    exprLabelHint: '(type it directly or paste an AI-generated one)',
    copyBtn: 'Copy',
    explainTitle: 'What this expression means',
    nextTitle: 'Next 5 run times (local timezone)',
    localNote: 'Everything is computed locally in your browser — no data is uploaded.',
    // How to use it once generated
    useH2: 'Once generated, where does it go?',
    useIntro:
      'A cron expression only describes <strong class="text-zinc-800 dark:text-zinc-200">when</strong>; what actually runs is a <strong class="text-zinc-800 dark:text-zinc-200">command</strong>. Join the two on one line and drop it into your system\'s scheduler. The examples below <strong class="text-violet-600 dark:text-violet-400">update live with the expression above</strong>.',
    b1Title: 'Linux / macOS: crontab (most common)',
    b1Desc:
      'Use this to run scripts on a schedule on a server. Enter the command you want to run to get the full "expression + command" line:',
    b1CmdLabel: 'The command to run',
    b1Steps: [
      '1. In a terminal, run <code class="inline-code">crontab -e</code> to open the current user\'s cron jobs',
      '2. Paste the whole line above',
      '3. Save and exit (in vim, press <code class="inline-code">Esc</code>, type <code class="inline-code">:wq</code> and hit Enter)',
      '4. Run <code class="inline-code">crontab -l</code> to list the jobs you\'ve added',
    ],
    b1Tip:
      '💡 Tip: cron runs with a very minimal PATH, so prefer <strong>absolute paths</strong> for commands (e.g. <code class="inline-code">/usr/bin/python3</code>); it also helps to write output to a log for debugging by appending <code class="inline-code">&gt;&gt; /var/log/mytask.log 2&gt;&amp;1</code> to the command.',
    b2Title: 'System-wide: /etc/cron.d (one extra "user" field)',
    b2Desc:
      'When writing into <code class="inline-code">/etc/crontab</code> or a file under <code class="inline-code">/etc/cron.d/</code>, you need one extra field — "which user to run as" — compared to a user crontab (requires root):',
    b3Title: 'Windows: no cron — use Task Scheduler',
    b3Desc: "Windows doesn't support cron syntax; here are three equivalent approaches:",
    b3Li1:
      '• <strong class="text-zinc-800 dark:text-zinc-200">GUI</strong>: search the Start menu for "Task Scheduler", create a task, and set its trigger time.',
    b3Li2:
      '• <strong class="text-zinc-800 dark:text-zinc-200">Command-line schtasks</strong>, e.g. "run every day at 03:00":',
    b3WSL:
      '• Or install <strong class="text-zinc-800 dark:text-zinc-200">WSL</strong> (Linux on Windows) and use the crontab above directly.',
    b3Note:
      'Note: schtasks uses its own flags (<code class="inline-code">/sc daily</code>, <code class="inline-code">/sc hourly</code>…) and does not accept cron expressions; for complex schedules, prefer WSL + crontab.',
    b4Title: 'In code or CI (reuse this expression directly)',
    b4Desc: 'Many frameworks accept cron expressions directly — just paste the expression generated above:',
    b4Spring: 'Spring (6 fields — seconds come first; a leading 0 is added automatically)',
    nodeComment: 'your task',
    // Examples
    examplesH2: 'Common cron expression examples',
    examplesDesc: 'Click any row to load it into the tool above and see its explanation and run times.',
    thExpr: 'Expression',
    thMeaning: 'Meaning',
    examples: [
      { expr: '*/5 * * * *', text: 'Every 5 minutes' },
      { expr: '0 * * * *', text: 'Every hour, on the hour' },
      { expr: '0 0 * * *', text: 'Every day at midnight' },
      { expr: '0 3 * * *', text: 'Every day at 3 AM (common for backups)' },
      { expr: '0 9 * * 1', text: 'Every Monday at 9 AM' },
      { expr: '0 0 1 * *', text: 'On the 1st of every month at midnight' },
      { expr: '0 18 * * 1-5', text: 'Weekdays (Mon–Fri) at 6 PM' },
      { expr: '30 2 * * 0', text: 'Every Sunday at 2:30 AM' },
    ],
    // FAQ
    faqH2: 'FAQ',
    faqs: [
      {
        q: 'What are the five fields in a cron expression?',
        a: 'From left to right: minute (0-59), hour (0-23), day of month (1-31), month (1-12), and day of week (0-6, where 0 is Sunday). Fields are separated by spaces.',
      },
      {
        q: "What's the difference between * and */5 in crontab?",
        a: '* means "every" (e.g. * in the minute field means every minute); */5 means "every 5 units" (e.g. */5 in the minute field means every 5 minutes).',
      },
      {
        q: 'Do both 0 and 7 mean Sunday in the day-of-week field?',
        a: 'In most implementations 0 means Sunday; some also accept 7 for Sunday. For compatibility, stick with 0.',
      },
      {
        q: 'How do I confirm the cron expression AI gave me is correct?',
        a: 'Paste it into the input above and the page instantly shows an explanation and the next 5 run times — you can verify at a glance that it matches your intent, without worrying about AI hallucinations.',
      },
    ],
    // Learn more / related
    deepH2: 'Learn more about cron',
    tierCore: 'Start here',
    tierAdvanced: 'Advanced · reference as needed',
    relatedH2: 'Related tools',
  },
}[lang];

const tiers = [
  { label: copy.tierCore, items: tiersData.core },
  { label: copy.tierAdvanced, items: tiersData.advanced },
];

const crumbs = [{ name: copy.home, href: localePath('/', lang) }, { name: tool.short }];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const related = relatedTools('cron', lang);
---

<BaseLayout title={copy.title} description={copy.description} ogType="article">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <Breadcrumb items={crumbs} lang={lang} />

    <!-- 标题 + 小白导语 -->
    <header class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
        {copy.h1}
      </h1>
      <div
        class="mt-4 rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900"
      >
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span
            class="rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-600 dark:bg-violet-500/10 dark:text-violet-400"
          >
            {tool.stage}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          <strong class="text-zinc-900 dark:text-white">{copy.whatIs}</strong>{tool.beginnerIntro}
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          <strong class="text-zinc-900 dark:text-white">{copy.whenUse}</strong>{tool.whenToUse}
        </p>
      </div>
    </header>

    <!-- 工具本体 -->
    <section class="mt-8">
      <!-- 预设 -->
      <div class="mb-4 flex flex-wrap gap-2">
        {
          cronPresets.map((p) => (
            <button
              type="button"
              data-expr={p.expr}
              class="cron-preset rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm text-zinc-600 transition-colors hover:border-violet-300 hover:text-violet-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-violet-700"
            >
              {p.label}
            </button>
          ))
        }
      </div>

      <!-- 表达式输入(可粘贴 AI 输出反向验证) -->
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
        <label for="cron-expr" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
          {copy.exprLabel} <span class="font-normal text-zinc-400">{copy.exprLabelHint}</span>
        </label>
        <div class="flex gap-2">
          <input
            id="cron-expr"
            type="text"
            value="*/5 * * * *"
            spellcheck="false"
            autocomplete="off"
            class="flex-1 rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-lg tracking-wide text-zinc-900 outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
          />
          <button
            id="cron-copy"
            type="button"
            class="shrink-0 rounded-xl bg-zinc-900 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
          >
            {copy.copyBtn}
          </button>
        </div>

        <!-- 字段构建器 -->
        <div class="mt-4 grid grid-cols-5 gap-2">
          {
            cronFields.map((f) => (
              <div>
                <label
                  for={`cf-${f.key}`}
                  class="mb-1 block text-center text-xs font-medium text-zinc-500 dark:text-zinc-400"
                >
                  {f.label}
                </label>
                <input
                  id={`cf-${f.key}`}
                  type="text"
                  class="cron-field w-full rounded-lg border border-zinc-300 bg-white px-2 py-2 text-center font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
                />
                <p class="mt-1 text-center text-[10px] text-zinc-400">{f.hint}</p>
              </div>
            ))
          }
        </div>

        <!-- 错误 -->
        <p id="cron-error" class="mt-4 hidden text-sm text-red-500"></p>

        <!-- 解释 -->
        <div id="cron-explain-wrap" class="mt-5 rounded-xl bg-violet-50 p-4 dark:bg-violet-500/10">
          <p class="text-xs font-medium text-violet-500">{copy.explainTitle}</p>
          <p id="cron-explain" class="mt-1 text-base font-medium text-zinc-900 dark:text-white"></p>
        </div>

        <!-- 下次执行 -->
        <div class="mt-4">
          <p class="mb-2 text-xs font-medium text-zinc-500 dark:text-zinc-400">{copy.nextTitle}</p>
          <ul id="cron-next" class="space-y-1.5 font-mono text-sm text-zinc-700 dark:text-zinc-300"></ul>
        </div>
      </div>

      <p class="mt-3 text-center text-xs text-zinc-400">
        {copy.localNote}
      </p>
    </section>

    <!-- 生成之后怎么用 -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">{copy.useH2}</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400" set:html={copy.useIntro} />

      <!-- 1. Linux/macOS crontab -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">1</span>
          {copy.b1Title}
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          {copy.b1Desc}
        </p>
        <div class="mt-3">
          <label for="cron-cmd" class="mb-1 block text-xs font-medium text-zinc-500 dark:text-zinc-400">{copy.b1CmdLabel}</label>
          <input
            id="cron-cmd"
            type="text"
            value="/path/to/your-script.sh"
            spellcheck="false"
            autocomplete="off"
            class="w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white"
          />
          <div class="relative mt-2">
            <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="crontab-line"></code></pre>
            <button data-copy-el="crontab-line" type="button" class="copy-mini">{copy.copyBtn}</button>
          </div>
        </div>
        <ol class="mt-4 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          {copy.b1Steps.map((s) => (<li set:html={s} />))}
        </ol>
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/5 dark:text-amber-300" set:html={copy.b1Tip} />
      </div>

      <!-- 2. 系统级 -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">2</span>
          {copy.b2Title}
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400" set:html={copy.b2Desc} />
        <div class="relative mt-3">
          <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="crontab-system"></code></pre>
          <button data-copy-el="crontab-system" type="button" class="copy-mini">{copy.copyBtn}</button>
        </div>
      </div>

      <!-- 3. Windows -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">3</span>
          {copy.b3Title}
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          {copy.b3Desc}
        </p>
        <ul class="mt-3 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
          <li set:html={copy.b3Li1} />
          <li set:html={copy.b3Li2} />
        </ul>
        <div class="relative mt-2">
          <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-schtasks">schtasks /create /tn "MyTask" /tr "C:\path\script.bat" /sc daily /st 03:00</code></pre>
          <button data-copy-el="snip-schtasks" type="button" class="copy-mini">{copy.copyBtn}</button>
        </div>
        <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400" set:html={copy.b3WSL} />
        <p class="mt-2 text-xs text-zinc-400" set:html={copy.b3Note} />
      </div>

      <!-- 4. 代码/CI -->
      <div class="mt-8">
        <h3 class="flex items-center gap-2 text-lg font-semibold text-zinc-900 dark:text-white">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-violet-100 text-xs text-violet-600 dark:bg-violet-500/15 dark:text-violet-400">4</span>
          {copy.b4Title}
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
          {copy.b4Desc}
        </p>
        <div class="mt-3 space-y-3">
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Node.js(node-cron)</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-node">cron.schedule('<span class="cron-expr-out"></span>', () =&gt; {`{`} /* {copy.nodeComment} */ {`}`})</code></pre>
              <button data-copy-el="snip-node" type="button" class="copy-mini">{copy.copyBtn}</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Python(APScheduler)</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-py">CronTrigger.from_crontab('<span class="cron-expr-out"></span>')</code></pre>
              <button data-copy-el="snip-py" type="button" class="copy-mini">{copy.copyBtn}</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">{copy.b4Spring}</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-spring">@Scheduled(cron = "<span class="cron-expr-spring"></span>")</code></pre>
              <button data-copy-el="snip-spring" type="button" class="copy-mini">{copy.copyBtn}</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">GitHub Actions</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-gha">on:
  schedule:
    - cron: '<span class="cron-expr-out"></span>'</code></pre>
              <button data-copy-el="snip-gha" type="button" class="copy-mini">{copy.copyBtn}</button>
            </div>
          </div>
          <div>
            <p class="mb-1 text-xs font-medium text-zinc-500 dark:text-zinc-400">Kubernetes CronJob</p>
            <div class="relative">
              <pre class="overflow-x-auto rounded-xl bg-zinc-900 p-4 pr-20 font-mono text-sm text-zinc-100"><code id="snip-k8s">schedule: "<span class="cron-expr-out"></span>"</code></pre>
              <button data-copy-el="snip-k8s" type="button" class="copy-mini">{copy.copyBtn}</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 常见示例 -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{copy.examplesH2}</h2>
      <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">{copy.examplesDesc}</p>
      <div class="mt-4 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800">
        <table class="w-full text-sm">
          <thead class="bg-zinc-50 text-left text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
            <tr>
              <th class="px-4 py-3 font-medium">{copy.thExpr}</th>
              <th class="px-4 py-3 font-medium">{copy.thMeaning}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {
              copy.examples.map((e) => (
                <tr
                  class="cron-preset cursor-pointer bg-white transition-colors hover:bg-violet-50 dark:bg-zinc-950 dark:hover:bg-violet-500/5"
                  data-expr={e.expr}
                >
                  <td class="px-4 py-3 font-mono text-violet-600 dark:text-violet-400">{e.expr}</td>
                  <td class="px-4 py-3 text-zinc-600 dark:text-zinc-300">{e.text}</td>
