    <!-- 相关工具 -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{copy.relatedH2}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          related.map((t) => (
            <a
              href={t.status === 'live' ? localePath(`/${t.slug}`, lang) : '#'}
              class="rounded-xl border border-zinc-200 bg-white p-4 text-sm transition-colors hover:border-violet-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
            >
              <span class="font-medium text-zinc-900 dark:text-white">{t.short}</span>
              <span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400">{t.desc}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <script>
    import { evaluateCron, formatDate } from '../../../lib/cron';

    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const COPIED = L === 'en' ? 'Copied' : '已复制';

    const exprInput = document.getElementById('cron-expr') as HTMLInputElement;
    const explainEl = document.getElementById('cron-explain')!;
    const explainWrap = document.getElementById('cron-explain-wrap')!;
    const nextEl = document.getElementById('cron-next')!;
    const errorEl = document.getElementById('cron-error')!;
    const copyBtn = document.getElementById('cron-copy') as HTMLButtonElement;
    const fieldKeys = ['min', 'hour', 'dom', 'month', 'dow'];
    const fieldInputs = fieldKeys.map(
      (k) => document.getElementById('cf-' + k) as HTMLInputElement
    );

    // "生成之后怎么用" 区块的实时联动
    const cmdInput = document.getElementById('cron-cmd') as HTMLInputElement | null;
    const crontabLine = document.getElementById('crontab-line');
    const crontabSystem = document.getElementById('crontab-system');
    const exprOuts = document.querySelectorAll<HTMLElement>('.cron-expr-out');
    const exprSpring = document.querySelectorAll<HTMLElement>('.cron-expr-spring');

    function updateUsage(expr: string) {
      const cmd = (cmdInput?.value.trim() || '/path/to/your-script.sh');
      if (crontabLine) crontabLine.textContent = `${expr} ${cmd}`;
      if (crontabSystem) crontabSystem.textContent = `${expr} root ${cmd}`;
      exprOuts.forEach((el) => (el.textContent = expr));
      exprSpring.forEach((el) => (el.textContent = `0 ${expr}`));
    }

    function syncFieldsFromExpr(expr: string) {
      const parts = expr.trim().split(/\s+/);
      if (parts.length === 5) parts.forEach((p, i) => (fieldInputs[i].value = p));
    }

    function exprFromFields() {
      return fieldInputs.map((f) => (f.value.trim() || '*')).join(' ');
    }

    function render(expr: string) {
      const res = evaluateCron(expr, L);
      if (res.explanation) {
        explainEl.textContent = res.explanation;
        explainWrap.classList.remove('opacity-40');
      } else {
        explainEl.textContent = '—';
        explainWrap.classList.add('opacity-40');
      }
      if (res.error) {
        errorEl.textContent = res.error;
        errorEl.classList.remove('hidden');
      } else {
        errorEl.classList.add('hidden');
      }
      if (res.ok && res.nextRuns) {
        nextEl.innerHTML = res.nextRuns
          .map(
            (d) =>
              `<li class="flex items-center gap-2"><span class="inline-block h-1.5 w-1.5 rounded-full bg-violet-400"></span>${formatDate(
                d,
                L
              )}</li>`
          )
          .join('');
      } else {
        nextEl.innerHTML = '';
      }
      updateUsage(res.expression || expr.trim().replace(/\s+/g, ' '));
    }

    cmdInput?.addEventListener('input', () => updateUsage(exprInput.value.trim().replace(/\s+/g, ' ')));

    // 直接编辑/粘贴表达式 -> 同步字段 + 渲染
    exprInput.addEventListener('input', () => {
      syncFieldsFromExpr(exprInput.value);
      render(exprInput.value);
    });

    // 编辑字段 -> 重建表达式 + 渲染
    fieldInputs.forEach((f) =>
      f.addEventListener('input', () => {
        const expr = exprFromFields();
        exprInput.value = expr;
        render(expr);
      })
    );

    // 预设 / 示例行
    document.querySelectorAll<HTMLElement>('.cron-preset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expr = btn.dataset.expr!;
        exprInput.value = expr;
        syncFieldsFromExpr(expr);
        render(expr);
        exprInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    // 复制表达式
    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(exprInput.value);
      const old = copyBtn.textContent;
      copyBtn.textContent = COPIED;
      setTimeout(() => (copyBtn.textContent = old), 1500);
    });

    // 通用:复制代码块([data-copy-el] -> 目标元素文本)
    document.querySelectorAll<HTMLButtonElement>('[data-copy-el]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const el = document.getElementById(btn.dataset.copyEl!);
        if (!el) return;
        await navigator.clipboard.writeText(el.innerText);
        const old = btn.textContent;
        btn.textContent = COPIED;
        setTimeout(() => (btn.textContent = old), 1500);
      });
    });

    // 初始化
    syncFieldsFromExpr(exprInput.value);
    render(exprInput.value);
  </script>
</BaseLayout>
