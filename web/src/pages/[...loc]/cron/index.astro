    </section>

    <!-- FAQ -->
    <section class="mt-14">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{copy.faqH2}</h2>
      <div class="mt-4 space-y-3">
        {
          copy.faqs.map((f) => (
            <details class="group rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <summary class="cursor-pointer list-none font-medium text-zinc-800 marker:content-none dark:text-zinc-100">
                <h3 class="inline">{f.q}</h3>
              </summary>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{f.a}</p>
