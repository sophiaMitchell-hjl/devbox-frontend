---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: '密码生成器 - 在线生成高强度随机密码 | DevBox',
    description:
      '在线密码生成器:可选长度与字符集(大小写/数字/符号),基于浏览器安全随机源本地生成,不联网、不记录,一键复制。',
    regenTitle: '重新生成',
    copy: '复制',
    length: '长度',
    lower: '小写 a-z',
    upper: '大写 A-Z',
    digits: '数字 0-9',
    symbols: '符号 !@#$',
    noamb: '排除易混字符 (0O1lI)',
    faqs: [
      {
        q: '这个密码安全吗?会被记录吗?',
        a: '密码使用浏览器的加密安全随机源(crypto.getRandomValues)在本地生成,不发送到任何服务器、也不保存,关闭页面即消失。',
      },
    ],
  },
  en: {
    title: 'Password Generator - Generate Strong Random Passwords Online | DevBox',
    description:
      'Online password generator: choose the length and character sets (upper/lowercase, digits, symbols). Generated locally from the browser secure random source — offline, unlogged, one-click copy.',
    regenTitle: 'Regenerate',
    copy: 'Copy',
    length: 'Length',
    lower: 'Lowercase a-z',
    upper: 'Uppercase A-Z',
    digits: 'Digits 0-9',
    symbols: 'Symbols !@#$',
    noamb: 'Exclude ambiguous chars (0O1lI)',
    faqs: [
      {
        q: 'Is this password safe? Is it logged?',
        a: 'Passwords are generated locally using the browser cryptographic secure random source (crypto.getRandomValues). Nothing is sent to any server or saved — it is gone once you close the page.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout slug="password" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="flex gap-2">
      <input id="out" type="text" readonly class="flex-1 rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-lg text-zinc-900 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" />
      <button id="regen" type="button" class="shrink-0 rounded-xl border border-zinc-300 px-4 text-sm dark:border-zinc-700 dark:text-zinc-200" title={copy.regenTitle}>↻</button>
      <button id="copy" type="button" class="shrink-0 rounded-xl bg-zinc-900 px-5 text-sm font-medium text-white dark:bg-white dark:text-zinc-900">{copy.copy}</button>
    </div>

    <div class="mt-3 flex items-center gap-2">
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
        <div id="bar" class="h-full w-0 rounded-full transition-all"></div>
      </div>
      <span id="strength" class="w-16 text-right text-xs text-zinc-400"></span>
    </div>

    <div class="mt-5 space-y-4">
      <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">
        <div class="flex items-center justify-between">{copy.length} <span id="len-val" class="font-mono text-zinc-400">16</span></div>
        <input id="len" type="range" min="6" max="64" value="16" class="mt-1 w-full accent-violet-600" />
      </label>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600 dark:text-zinc-300">
        <label class="flex items-center gap-2"><input id="lower" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> {copy.lower}</label>
        <label class="flex items-center gap-2"><input id="upper" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> {copy.upper}</label>
        <label class="flex items-center gap-2"><input id="digits" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> {copy.digits}</label>
        <label class="flex items-center gap-2"><input id="symbols" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> {copy.symbols}</label>
        <label class="flex items-center gap-2"><input id="noamb" type="checkbox" class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> {copy.noamb}</label>
      </div>
    </div>
  </div>

  <script>
    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      weak: L === 'en' ? 'Weak' : '弱',
      fair: L === 'en' ? 'Fair' : '中',
      strong: L === 'en' ? 'Strong' : '强',
      veryStrong: L === 'en' ? 'Very strong' : '极强',
      bits: (b: number) => (L === 'en' ? `${b} bits` : `${b}位`),
    };
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const out = $('out');
    const bar = document.getElementById('bar')!;
    const strengthEl = document.getElementById('strength')!;
    const lenVal = document.getElementById('len-val')!;

    function pool() {
      let p = '';
      if ($('lower').checked) p += 'abcdefghijklmnopqrstuvwxyz';
      if ($('upper').checked) p += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if ($('digits').checked) p += '0123456789';
      if ($('symbols').checked) p += '!@#$%^&*()-_=+[]{};:,.<>?';
      if ($('noamb').checked) p = p.replace(/[0O1lI]/g, '');
      return p || 'abcdefghijklmnopqrstuvwxyz';
    }

    function gen() {
      const len = Number($('len').value);
      lenVal.textContent = String(len);
      const p = pool();
      const arr = new Uint32Array(len);
      crypto.getRandomValues(arr);
      let s = '';
      for (let i = 0; i < len; i++) s += p[arr[i] % p.length];
      out.value = s;
      // 强度:基于熵 log2(pool)*len
      const bits = Math.round(Math.log2(p.length) * len);
      let label = TXT.weak, color = '#ef4444', w = 33;
      if (bits >= 128) { label = TXT.veryStrong; color = '#10b981'; w = 100; }
      else if (bits >= 80) { label = TXT.strong; color = '#22c55e'; w = 80; }
      else if (bits >= 60) { label = TXT.fair; color = '#f59e0b'; w = 55; }
      bar.style.width = w + '%';
      bar.style.background = color;
      strengthEl.textContent = `${label} ${TXT.bits(bits)}`;
    }

    ['len', 'lower', 'upper', 'digits', 'symbols', 'noamb'].forEach((id) => $(id).addEventListener('input', gen));
    document.getElementById('regen')!.addEventListener('click', gen);
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(out.value);
    });
    gen();
  </script>
</ToolPageLayout>
