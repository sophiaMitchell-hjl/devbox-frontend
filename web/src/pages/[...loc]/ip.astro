---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: 'IP 地址查询 - 查看我的公网 IP 与归属地 | DevBox',
    description:
      '在线查询你的公网 IP 地址、归属地、运营商与时区。由 DevBox 后端返回,不记录查询记录。',
    note: '本工具需要服务器来获取你的公网 IP,会向 DevBox 后端发起一次请求;后端不记录你的查询。',
    netInfo: '你的网络信息',
    refresh: '刷新',
    faqs: [
      {
        q: '为什么这个工具需要联网,而别的工具不用?',
        a: '公网 IP 只有服务器才能看到(你的浏览器本身并不知道自己的公网 IP),所以本工具会向 DevBox 后端发起一次请求。其余工具都在你的浏览器本地运行、不联网。',
      },
      {
        q: '归属地准确吗?',
        a: '归属地基于公开的 IP 数据库,精确到城市级别,可能有偏差;使用代理/VPN 时显示的是出口节点的位置。',
      },
    ],
  },
  en: {
    title: 'IP Address Lookup - See My Public IP and Location | DevBox',
    description:
      'Look up your public IP address, location, ISP, and timezone online. Returned by the DevBox backend, with no query logging.',
    note: 'This tool needs a server to obtain your public IP, so it makes one request to the DevBox backend; the backend does not log your query.',
    netInfo: 'Your network info',
    refresh: 'Refresh',
    faqs: [
      {
        q: 'Why does this tool need a network connection when others do not?',
        a: 'Only a server can see your public IP (your browser itself does not know its own public IP), so this tool makes one request to the DevBox backend. Every other tool runs locally in your browser with no network access.',
      },
      {
        q: 'Is the location accurate?',
        a: 'The location is based on public IP databases, accurate to city level and possibly off; when using a proxy/VPN it shows the location of the exit node.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout
  slug="ip"
  title={copy.title}
  description={copy.description}
  faqs={copy.faqs}
  note={copy.note}
>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="mb-4 flex items-center justify-between">
      <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.netInfo}</span>
      <button id="refresh" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">{copy.refresh}</button>
    </div>
    <div id="ip-big" class="mb-4 font-mono text-3xl font-bold text-zinc-900 dark:text-white">…</div>
    <div id="out" class="divide-y divide-zinc-100 dark:divide-zinc-800"></div>
    <p id="err" class="mt-4 hidden rounded-lg bg-amber-50 p-3 text-sm text-amber-700 dark:bg-amber-500/5 dark:text-amber-300"></p>
  </div>

  <script>
    import { apiGet } from '../../lib/api';

    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      querying: L === 'en' ? 'Looking up…' : '查询中…',
      unknown: L === 'en' ? '(unknown)' : '(未知)',
      location: L === 'en' ? 'Location' : '归属地',
      isp: L === 'en' ? 'ISP' : '运营商',
      timezone: L === 'en' ? 'Timezone' : '时区',
      browserLang: L === 'en' ? 'Browser language' : '浏览器语言',
      err:
        L === 'en'
          ? 'Cannot reach the backend service (/api/ip). For local development, start FastAPI first: .venv/Scripts/python -m uvicorn main:app --app-dir api --port 8000'
          : '无法连接后端服务(/api/ip)。本地开发请先启动 FastAPI:.venv/Scripts/python -m uvicorn main:app --app-dir api --port 8000',
    };

    const bigEl = document.getElementById('ip-big')!;
    const out = document.getElementById('out')!;
    const err = document.getElementById('err')!;

    interface IpInfo {
      ip: string;
      userAgent?: string;
      language?: string;
      country?: string;
      region?: string;
      city?: string;
      isp?: string;
      timezone?: string;
    }

    function row(label: string, val?: string) {
      if (!val) return null;
      const wrap = document.createElement('div');
      wrap.className = 'flex items-center justify-between gap-3 py-2.5';
      const l = document.createElement('span');
      l.className = 'text-sm text-zinc-500 dark:text-zinc-400';
      l.textContent = label;
      const v = document.createElement('span');
      v.className = 'text-right font-mono text-sm text-zinc-800 dark:text-zinc-100';
      v.textContent = val;
      wrap.append(l, v);
      return wrap;
    }

    async function load() {
      err.classList.add('hidden');
      bigEl.textContent = TXT.querying;
      out.replaceChildren();
      try {
        const d = await apiGet<IpInfo>('/api/ip');
        bigEl.textContent = d.ip || TXT.unknown;
        const loc = [d.country, d.region, d.city].filter(Boolean).join(' · ');
        const rows = [
          row(TXT.location, loc),
          row(TXT.isp, d.isp),
          row(TXT.timezone, d.timezone),
          row(TXT.browserLang, d.language),
          row('User-Agent', d.userAgent),
        ].filter((r): r is HTMLElement => r !== null);
        out.append(...rows);
      } catch {
        bigEl.textContent = '—';
        err.textContent = TXT.err;
        err.classList.remove('hidden');
      }
    }

    document.getElementById('refresh')!.addEventListener('click', load);
    load();
  </script>
</ToolPageLayout>
