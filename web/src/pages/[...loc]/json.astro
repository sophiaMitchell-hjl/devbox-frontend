---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: 'JSON 格式化 / 校验 - 在线美化、压缩与排序 | DevBox',
    description:
      '在线 JSON 格式化工具:一键美化、压缩、校验 JSON,可按键名排序,语法错误精准提示。浏览器本地处理,可用于校验 AI 生成的 JSON。',
    faqs: [
      {
        q: 'JSON 报错怎么定位?',
        a: '点"校验/格式化"后,若有语法错误会显示错误信息(通常包含出错位置)。常见问题是多了逗号、少了引号、用了单引号或注释——标准 JSON 都不允许。',
      },
    ],
    pretty: '格式化',
    min: '压缩',
    sort: '排序键名',
    upload: '上传 JSON 文件',
    copyResult: '复制结果',
    inputLabel: '输入',
    outputLabel: '输出',
    inPlaceholder: '示例输入:{"a":1,"b":[2,3]}',
    outPlaceholder: '示例输出:{ "a": 1, "b": [2, 3] }',
  },
  en: {
    title: 'JSON Formatter / Validator - Beautify, Minify & Sort Online | DevBox',
    description:
      'Online JSON formatter: beautify, minify and validate JSON in one click, sort by key, with precise syntax-error hints. Processed locally in your browser — great for validating AI-generated JSON.',
    faqs: [
      {
        q: 'How do I locate a JSON error?',
        a: 'After clicking Format, any syntax error is shown with a message (usually including the position). Common causes are trailing commas, missing quotes, single quotes or comments — none of which standard JSON allows.',
      },
    ],
    pretty: 'Format',
    min: 'Minify',
    sort: 'Sort keys',
    upload: 'Upload JSON file',
    copyResult: 'Copy result',
    inputLabel: 'Input',
    outputLabel: 'Output',
    inPlaceholder: 'Example input: {"a":1,"b":[2,3]}',
    outPlaceholder: 'Example output: { "a": 1, "b": [2, 3] }',
  },
}[lang];

const areaCls =
  'w-full h-96 rounded-xl border border-zinc-300 bg-zinc-50 p-4 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="json" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button data-act="pretty" class="act-btn rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">{copy.pretty}</button>
    <button data-act="min" class="act-btn rounded-lg border border-zinc-300 px-4 py-1.5 text-sm text-zinc-700 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-200">{copy.min}</button>
    <button data-act="sort" class="act-btn rounded-lg border border-zinc-300 px-4 py-1.5 text-sm text-zinc-700 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-200">{copy.sort}</button>
    <label class="cursor-pointer rounded-lg border border-zinc-300 px-4 py-1.5 text-sm text-zinc-700 hover:border-zinc-400 dark:border-zinc-700 dark:text-zinc-200">
      {copy.upload}
      <input id="file" type="file" accept=".json,application/json,.txt" class="hidden" />
    </label>
    <button id="copy" type="button" class="ml-auto text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copyResult}</button>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.inputLabel}</label>
      <textarea id="in" class={areaCls} data-clear-target="out" placeholder={copy.inPlaceholder} spellcheck="false"></textarea>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.outputLabel}</label>
      <textarea id="out" class={areaCls} readonly placeholder={copy.outPlaceholder}></textarea>
    </div>
  </div>
  <p id="msg" class="mt-3 text-sm"></p>

  <script>
    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const inEl = document.getElementById('in') as HTMLTextAreaElement;
    const outEl = document.getElementById('out') as HTMLTextAreaElement;
    const msg = document.getElementById('msg')!;

    function sortKeys(v: any): any {
      if (Array.isArray(v)) return v.map(sortKeys);
      if (v && typeof v === 'object') {
        return Object.keys(v)
          .sort()
          .reduce((acc: any, k) => {
            acc[k] = sortKeys(v[k]);
            return acc;
          }, {});
      }
      return v;
    }

    function run(act: string) {
      const raw = inEl.value.trim();
      if (!raw) {
        outEl.value = '';
        msg.textContent = '';
        return;
      }
      let obj: any;
      try {
        obj = JSON.parse(raw);
      } catch (e) {
        outEl.value = '';
        msg.className = 'mt-3 text-sm text-red-500';
        msg.textContent = (L === 'en' ? '❌ Invalid JSON: ' : '❌ 无效 JSON:') + (e as Error).message;
        return;
      }
      if (act === 'sort') obj = sortKeys(obj);
      outEl.value = act === 'min' ? JSON.stringify(obj) : JSON.stringify(obj, null, 2);
      msg.className = 'mt-3 text-sm text-emerald-600 dark:text-emerald-400';
      msg.textContent = L === 'en' ? '✓ Valid JSON' : '✓ JSON 合法';
    }

    document.querySelectorAll<HTMLButtonElement>('.act-btn').forEach((b) =>
      b.addEventListener('click', () => run(b.dataset.act!))
    );
    inEl.addEventListener('input', () => run('pretty'));

    // 上传 JSON 文件
    const fileEl = document.getElementById('file') as HTMLInputElement;
    fileEl.addEventListener('change', () => {
      const f = fileEl.files?.[0];
      if (!f) return;
      const reader = new FileReader();
      reader.onload = () => {
        inEl.value = String(reader.result ?? '');
        run('pretty');
      };
      reader.readAsText(f);
      fileEl.value = ''; // 允许再次选同一文件
    });
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(outEl.value);
    });
  </script>
</ToolPageLayout>
