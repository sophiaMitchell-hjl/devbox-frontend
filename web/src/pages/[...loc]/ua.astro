---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: 'UserAgent 解析器 - 在线识别浏览器/系统/设备 | DevBox',
    description:
      '在线 User-Agent 解析:粘贴 UA 字符串,识别浏览器及版本、操作系统、设备类型。默认填入当前浏览器 UA,本地解析不上传。',
    uaLabel: 'User-Agent 字符串',
    faqs: [
      {
        q: 'User-Agent 是什么?',
        a: '它是浏览器每次请求时自报的一串身份文本,包含浏览器、版本、操作系统等信息。服务器常用它做兼容性判断或统计。',
      },
    ],
  },
  en: {
    title: 'User-Agent Parser - Identify Browser/OS/Device Online | DevBox',
    description:
      'Online User-Agent parser: paste a UA string to identify the browser and version, operating system, and device type. Pre-filled with your current browser UA, parsed locally, nothing uploaded.',
    uaLabel: 'User-Agent string',
    faqs: [
      {
        q: 'What is a User-Agent?',
        a: 'It is a string a browser reports on every request to identify itself, including the browser, version, and operating system. Servers often use it for compatibility decisions or analytics.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout slug="ua" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.uaLabel}</label>
  <textarea id="in" class="h-24 w-full rounded-xl border border-zinc-300 bg-zinc-50 p-4 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" spellcheck="false"></textarea>

  <div id="out" class="mt-5 grid gap-3 sm:grid-cols-2"></div>

  <script>
    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      unknown: L === 'en' ? 'Unknown' : '未知',
      mobile: L === 'en' ? 'Mobile' : '移动设备',
      tablet: L === 'en' ? 'Tablet' : '平板',
      desktop: L === 'en' ? 'Desktop' : '桌面',
      browser: L === 'en' ? 'Browser' : '浏览器',
      version: L === 'en' ? 'Version' : '版本',
      os: L === 'en' ? 'Operating system' : '操作系统',
      device: L === 'en' ? 'Device type' : '设备类型',
    };
    const inEl = document.getElementById('in') as HTMLTextAreaElement;
    const out = document.getElementById('out')!;

    function parse(ua: string) {
      let browser = TXT.unknown, version = '';
      const b: [string, RegExp][] = [
        ['Edge', /Edg\/([\d.]+)/],
        ['Opera', /OPR\/([\d.]+)/],
        ['Chrome', /Chrome\/([\d.]+)/],
        ['Firefox', /Firefox\/([\d.]+)/],
        ['Safari', /Version\/([\d.]+).*Safari/],
      ];
      for (const [name, re] of b) {
        const m = ua.match(re);
        if (m) { browser = name; version = m[1]; break; }
      }
      let os = TXT.unknown;
      if (/Windows NT 10/.test(ua)) os = 'Windows 10/11';
      else if (/Windows NT/.test(ua)) os = 'Windows';
      else if (/Android ([\d.]+)/.test(ua)) os = 'Android ' + (ua.match(/Android ([\d.]+)/)?.[1] || '');
      else if (/(iPhone|iPad).*OS ([\d_]+)/.test(ua)) os = 'iOS ' + (ua.match(/OS ([\d_]+)/)?.[1]?.replace(/_/g, '.') || '');
      else if (/Mac OS X ([\d_]+)/.test(ua)) os = 'macOS ' + (ua.match(/Mac OS X ([\d_]+)/)?.[1]?.replace(/_/g, '.') || '');
      else if (/Linux/.test(ua)) os = 'Linux';
      const device = /Mobile|Android|iPhone/.test(ua) ? TXT.mobile : /iPad|Tablet/.test(ua) ? TXT.tablet : TXT.desktop;
      return { browser, version, os, device };
    }

    function row(label: string, val: string) {
      return `<div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900"><p class="text-xs text-zinc-400">${label}</p><p class="mt-1 font-medium text-zinc-900 dark:text-white">${val || '—'}</p></div>`;
    }

    function run() {
      const r = parse(inEl.value);
      out.innerHTML =
        row(TXT.browser, r.browser) +
        row(TXT.version, r.version) +
        row(TXT.os, r.os) +
        row(TXT.device, r.device);
    }

    inEl.addEventListener('input', run);
    inEl.value = navigator.userAgent;
    run();
  </script>
</ToolPageLayout>
