---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: '图片转 Base64 / DataURL - 内嵌到 CSS/HTML | DevBox',
    description:
      '在线把图片转成 Base64 DataURL,直接内嵌进 CSS background 或 HTML img,减少一次请求。浏览器本地转换,图片不上传。',
    previewAlt: '预览',
    copy: '复制',
    faqs: [
      {
        q: '什么图片适合转 DataURL?',
        a: '适合很小的图标/占位图。DataURL 会让体积增大约 33% 且无法单独缓存,大图不建议内联。',
      },
    ],
  },
  en: {
    title: 'Image to Base64 / DataURL - Embed in CSS/HTML | DevBox',
    description:
      'Turn an image into a Base64 DataURL online to embed directly in a CSS background or HTML img, saving a request. Converted locally in the browser — images are never uploaded.',
    previewAlt: 'Preview',
    copy: 'Copy',
    faqs: [
      {
        q: 'Which images are good for DataURLs?',
        a: 'Small icons/placeholders. A DataURL grows about 33% larger and cannot be cached separately, so large images should not be inlined.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout slug="dataurl" title={copy.title} description={copy.description} faqs={copy.faqs}>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <input id="file" type="file" accept="image/*" class="text-sm text-zinc-600 file:mr-3 file:rounded-lg file:border-0 file:bg-zinc-900 file:px-4 file:py-2 file:text-white dark:text-zinc-300 dark:file:bg-white dark:file:text-zinc-900" />

    <div id="result" class="mt-6 hidden">
      <div class="flex items-center gap-4">
        <img id="preview" class="h-20 w-20 rounded-lg border border-zinc-200 object-contain dark:border-zinc-800" alt={copy.previewAlt} />
        <span id="size" class="text-sm text-zinc-500 dark:text-zinc-400"></span>
      </div>

      <div class="mt-4 space-y-3">
        <div>
          <div class="mb-1 flex items-center justify-between"><span class="text-xs font-medium text-zinc-500">DataURL</span><button data-t="raw" class="cp text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copy}</button></div>
          <pre class="max-h-32 overflow-auto rounded-lg bg-zinc-900 p-3 font-mono text-xs whitespace-pre-wrap break-all text-zinc-100"><code id="raw"></code></pre>
        </div>
        <div>
          <div class="mb-1 flex items-center justify-between"><span class="text-xs font-medium text-zinc-500">CSS background</span><button data-t="css" class="cp text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copy}</button></div>
          <pre class="max-h-24 overflow-auto rounded-lg bg-zinc-900 p-3 font-mono text-xs whitespace-pre-wrap break-all text-zinc-100"><code id="css"></code></pre>
        </div>
        <div>
          <div class="mb-1 flex items-center justify-between"><span class="text-xs font-medium text-zinc-500">HTML img</span><button data-t="html" class="cp text-xs font-medium text-violet-600 dark:text-violet-400">{copy.copy}</button></div>
          <pre class="max-h-24 overflow-auto rounded-lg bg-zinc-900 p-3 font-mono text-xs whitespace-pre-wrap break-all text-zinc-100"><code id="html"></code></pre>
        </div>
      </div>
    </div>
  </div>

  <script>
    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      copy: L === 'en' ? 'Copy' : '复制',
      copied: L === 'en' ? 'Copied' : '已复制',
      orig: L === 'en' ? 'Original' : '原始',
    };
    const fileEl = document.getElementById('file') as HTMLInputElement;
    const result = document.getElementById('result')!;
    const preview = document.getElementById('preview') as HTMLImageElement;
    const sizeEl = document.getElementById('size')!;
    const raw = document.getElementById('raw')!;
    const cssEl = document.getElementById('css')!;
    const htmlEl = document.getElementById('html')!;

    const fmt = (b: number) => (b < 1024 ? b + ' B' : (b / 1024).toFixed(1) + ' KB');

    fileEl.addEventListener('change', () => {
      const f = fileEl.files?.[0];
      if (!f) return;
      const reader = new FileReader();
      reader.onload = () => {
        const url = String(reader.result);
        preview.src = url;
        raw.textContent = url;
        cssEl.textContent = `background-image: url("${url}");`;
        htmlEl.textContent = `<img src="${url}" alt="">`;
        sizeEl.textContent = `${TXT.orig} ${fmt(f.size)} · DataURL ${fmt(url.length)}`;
        result.classList.remove('hidden');
      };
      reader.readAsDataURL(f);
    });

    document.querySelectorAll<HTMLButtonElement>('.cp').forEach((b) =>
      b.addEventListener('click', async () => {
        await navigator.clipboard.writeText(document.getElementById(b.dataset.t!)!.textContent || '');
        b.textContent = TXT.copied; setTimeout(() => (b.textContent = TXT.copy), 1200);
      })
    );
  </script>
</ToolPageLayout>
