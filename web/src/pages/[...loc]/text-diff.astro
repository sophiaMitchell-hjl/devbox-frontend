---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { localePaths, langOfParam } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const copy = {
  zh: {
    title: '文本对比 Diff | DevBox',
    description: '在线文本差异对比工具，逐行高亮显示新增、删除与未变更内容，支持深色模式。',
    original: '原始文本 / 修改前',
    modified: '修改后文本',
    compare: '对比',
    swap: '互换',
    clear: '清空',
    placeholder_left: '在此粘贴原始文本…',
    placeholder_right: '在此粘贴修改后文本…',
    stats_added: '行新增',
    stats_removed: '行删除',
    stats_unchanged: '行未变更',
    collapsed: '… 省略 {n} 行未变更内容 …',
    no_diff: '两段文本完全相同，无差异。',
    empty: '请在两侧输入文本后点击"对比"。',
    result_title: '对比结果',
    faqs: [
      {
        q: '这个工具使用什么算法？',
        a: '本工具在浏览器端使用 Myers 差异算法（Myers Diff Algorithm）进行逐行对比，该算法是 GNU diff 等主流工具所采用的标准算法，能够找出最短编辑路径。',
      },
      {
        q: '文本会被上传到服务器吗？',
        a: '不会。所有对比计算完全在您的浏览器本地完成，文本数据不会发送到任何服务器，请放心使用。',
      },
    ],
  },
  en: {
    title: 'Text Diff | DevBox',
    description: 'Side-by-side text diff tool with line-level highlighting for additions, deletions, and unchanged lines. Runs entirely in your browser.',
    original: 'Original / Before',
    modified: 'Modified / After',
    compare: 'Compare',
    swap: 'Swap',
    clear: 'Clear',
    placeholder_left: 'Paste original text here…',
    placeholder_right: 'Paste modified text here…',
    stats_added: 'added',
    stats_removed: 'removed',
    stats_unchanged: 'unchanged',
    collapsed: '… {n} unchanged lines …',
    no_diff: 'The two texts are identical — no differences found.',
    empty: 'Enter text in both panels then click "Compare".',
    result_title: 'Diff Result',
    faqs: [
      {
        q: 'What algorithm does this tool use?',
        a: 'The tool runs the Myers Diff Algorithm entirely in your browser. Myers diff is the standard algorithm used by GNU diff and most version-control systems — it finds the shortest edit script between two sequences.',
      },
      {
        q: 'Is my text sent to a server?',
        a: 'No. All comparison logic runs client-side in your browser. Your text never leaves your device.',
      },
    ],
  },
}[lang];
---

<ToolPageLayout slug="text-diff" title={copy.title} description={copy.description} faqs={copy.faqs}>

  <!-- Toolbar -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-zinc-900 dark:text-white">{copy.result_title}</h2>
    <div class="flex gap-2">
      <button id="btn-swap"
        class="rounded-lg border border-zinc-300 bg-white px-4 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800">
        {copy.swap}
      </button>
      <button id="btn-clear"
        class="rounded-lg border border-zinc-300 bg-white px-4 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800">
        {copy.clear}
      </button>
      <button id="btn-compare"
        class="rounded-lg bg-zinc-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">
        {copy.compare}
      </button>
    </div>
  </div>

  <!-- Input panels -->
  <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label for="ta-left" class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.original}</label>
      <textarea
        id="ta-left"
        rows="14"
        placeholder={copy.placeholder_left}
        class="w-full resize-y rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white dark:placeholder-zinc-600"
      ></textarea>
    </div>
    <div class="flex flex-col gap-2">
      <label for="ta-right" class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.modified}</label>
      <textarea
        id="ta-right"
        rows="14"
        placeholder={copy.placeholder_right}
        class="w-full resize-y rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white dark:placeholder-zinc-600"
      ></textarea>
    </div>
  </div>

  <!-- Stats bar -->
  <div id="stats-bar" class="mb-4 hidden flex-wrap items-center gap-3">
    <span id="stat-added"
      class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"></span>
    <span id="stat-removed"
      class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-medium text-red-700 dark:bg-red-500/10 dark:text-red-400"></span>
    <span id="stat-unchanged"
      class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"></span>
  </div>

  <!-- Diff output -->
  <div id="diff-output" class="rounded-2xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
    <div id="diff-placeholder" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
      {copy.empty}
    </div>
    <div id="diff-table-wrap" class="hidden overflow-x-auto">
      <table id="diff-table" class="w-full border-collapse font-mono text-sm"></table>
    </div>
  </div>

  <script define:vars={{ copy }}>
    // ─── Myers Diff Algorithm ─────────────────────────────────────────────────
    /**
     * Compute the shortest edit script between two arrays using Myers' algorithm.
     * Returns an array of { type: 'equal'|'insert'|'delete', lines: string[] }
     */
    function myersDiff(aLines, bLines) {
      const N = aLines.length;
      const M = bLines.length;
      const MAX = N + M;

      if (MAX === 0) return [];

      // v[k] = furthest reaching x-coordinate along diagonal k
      const v = new Array(2 * MAX + 1).fill(0);
      const trace = [];

      outer: for (let d = 0; d <= MAX; d++) {
        const snapshot = v.slice();
        trace.push(snapshot);
        for (let k = -d; k <= d; k += 2) {
          let x;
          if (k === -d || (k !== d && v[k - 1 + MAX] < v[k + 1 + MAX])) {
            x = v[k + 1 + MAX]; // move down (insert)
          } else {
            x = v[k - 1 + MAX] + 1; // move right (delete)
          }
          let y = x - k;
          while (x < N && y < M && aLines[x] === bLines[y]) {
            x++;
            y++;
          }
          v[k + MAX] = x;
          if (x >= N && y >= M) {
            trace.push(v.slice());
            break outer;
          }
        }
      }

      // Backtrack to find the edit path
      const edits = []; // { type: 'equal'|'insert'|'delete', a: number, b: number }
      let x = N;
      let y = M;

      for (let d = trace.length - 1; d >= 1; d--) {
        const prev = trace[d - 1];
        const k = x - y;

        let prevK;
        if (k === -d + 1 || (k !== d - 1 && (prev[k - 1 + MAX] ?? -1) < (prev[k + 1 + MAX] ?? -1))) {
          prevK = k + 1;
        } else {
          prevK = k - 1;
        }

        const prevX = prev[prevK + MAX] ?? 0;
        const prevY = prevX - prevK;

        while (x > prevX + 1 && y > prevY + 1) {
          edits.unshift({ type: 'equal', a: x - 1, b: y - 1 });
          x--;
          y--;
        }

        if (d > 0) {
          if (x === prevX + 1 && y === prevY) {
            edits.unshift({ type: 'delete', a: x - 1, b: -1 });
            x--;
          } else if (y === prevY + 1 && x === prevX) {
            edits.unshift({ type: 'insert', a: -1, b: y - 1 });
            y--;
          } else if (x > prevX && y > prevY) {
            edits.unshift({ type: 'equal', a: x - 1, b: y - 1 });
            x--;
            y--;
          }
        }
      }

      // Merge consecutive edits of the same type into operation groups
      const ops = [];
      for (const e of edits) {
        const line = e.type === 'delete' ? aLines[e.a] : e.type === 'insert' ? bLines[e.b] : aLines[e.a];
        if (ops.length > 0 && ops[ops.length - 1].type === e.type) {
          ops[ops.length - 1].lines.push(line);
        } else {
          ops.push({ type: e.type, lines: [line] });
        }
      }
      return ops;
    }

    // ─── DOM refs ─────────────────────────────────────────────────────────────
    const taLeft = document.getElementById('ta-left');
    const taRight = document.getElementById('ta-right');
    const btnCompare = document.getElementById('btn-compare');
    const btnSwap = document.getElementById('btn-swap');
    const btnClear = document.getElementById('btn-clear');
    const statsBar = document.getElementById('stats-bar');
    const statAdded = document.getElementById('stat-added');
    const statRemoved = document.getElementById('stat-removed');
    const statUnchanged = document.getElementById('stat-unchanged');
    const diffPlaceholder = document.getElementById('diff-placeholder');
    const diffTableWrap = document.getElementById('diff-table-wrap');
    const diffTable = document.getElementById('diff-table');

    const CONTEXT = 3; // lines of context around changes

    // ─── Render diff ──────────────────────────────────────────────────────────
    function runDiff() {
      const left = taLeft.value;
      const right = taRight.value;

      if (left === '' && right === '') {
        showPlaceholder(copy.empty);
        statsBar.classList.add('hidden');
        return;
      }

      const aLines = left === '' ? [] : left.split('\n');
      const bLines = right === '' ? [] : right.split('\n');

      const ops = myersDiff(aLines, bLines);

      // Count stats
      let added = 0, removed = 0, unchanged = 0;
      for (const op of ops) {
        if (op.type === 'insert') added += op.lines.length;
        else if (op.type === 'delete') removed += op.lines.length;
        else unchanged += op.lines.length;
      }

      // Update stats bar
      statAdded.textContent = `+${added} ${copy.stats_added}`;
      statRemoved.textContent = `−${removed} ${copy.stats_removed}`;
      statUnchanged.textContent = `${unchanged} ${copy.stats_unchanged}`;
      statsBar.classList.remove('hidden');
      statsBar.style.display = 'flex';

      if (added === 0 && removed === 0) {
        showPlaceholder(copy.no_diff);
        return;
      }

      // Build flat list of display rows
      // Each row: { kind: 'equal'|'insert'|'delete'|'collapse', lineNoA, lineNoB, text, collapseCount }
      const rows = buildRows(ops);

      // Render table
      renderTable(rows);
    }

    function buildRows(ops) {
      // First, flatten ops into individual line records with line numbers
      const flat = [];
      let lineA = 1;
      let lineB = 1;
      for (const op of ops) {
        for (const line of op.lines) {
          if (op.type === 'equal') {
            flat.push({ kind: 'equal', lineA, lineB, text: line });
            lineA++;
            lineB++;
          } else if (op.type === 'delete') {
            flat.push({ kind: 'delete', lineA, lineB: null, text: line });
            lineA++;
          } else {
            flat.push({ kind: 'insert', lineA: null, lineB, text: line });
            lineB++;
          }
        }
      }

      // Determine which equal lines are "context" (within CONTEXT lines of a change)
      const changed = flat.map(r => r.kind !== 'equal');
      const isContext = flat.map((_, i) => {
        if (changed[i]) return true;
        for (let d = 1; d <= CONTEXT; d++) {
          if ((i - d >= 0 && changed[i - d]) || (i + d < changed.length && changed[i + d])) return true;
        }
        return false;
      });

      // Build final rows, inserting collapse markers
      const rows = [];
      let collapseStart = -1;
      for (let i = 0; i < flat.length; i++) {
        if (!isContext[i]) {
          if (collapseStart === -1) collapseStart = i;
        } else {
          if (collapseStart !== -1) {
            const count = i - collapseStart;
            rows.push({ kind: 'collapse', collapseCount: count });
            collapseStart = -1;
          }
          rows.push(flat[i]);
        }
      }
      if (collapseStart !== -1) {
        const count = flat.length - collapseStart;
        rows.push({ kind: 'collapse', collapseCount: count });
      }
      return rows;
    }

    function renderTable(rows) {
      // Clear table
      while (diffTable.firstChild) diffTable.removeChild(diffTable.firstChild);

      const tbody = document.createElement('tbody');

      for (const row of rows) {
        const tr = document.createElement('tr');

        if (row.kind === 'collapse') {
          tr.className = 'bg-zinc-50 dark:bg-zinc-800/50';
          const td = document.createElement('td');
          td.colSpan = 3;
          td.className = 'px-4 py-1.5 text-center text-xs text-zinc-500 dark:text-zinc-400 select-none';
          td.textContent = copy.collapsed.replace('{n}', String(row.collapseCount));
          tr.appendChild(td);
        } else {
          // Line number cells
          const tdNumA = document.createElement('td');
          const tdNumB = document.createElement('td');
          const tdSign = document.createElement('td');
          const tdCode = document.createElement('td');

          // Base row styling
          let bgClass = '';
          let signChar = ' ';
          let signColor = '';
          if (row.kind === 'delete') {
            bgClass = 'bg-red-500/10';
            signChar = '−';
            signColor = 'text-red-600 dark:text-red-400';
            tr.className = bgClass;
          } else if (row.kind === 'insert') {
            bgClass = 'bg-emerald-500/10';
            signChar = '+';
            signColor = 'text-emerald-600 dark:text-emerald-400';
            tr.className = bgClass;
          } else {
            tr.className = 'hover:bg-zinc-50 dark:hover:bg-zinc-800/40';
          }

          // Line number A
          tdNumA.className = 'w-10 min-w-[2.5rem] select-none border-r border-zinc-200 px-2 py-0.5 text-right text-xs tabular-nums text-zinc-400 dark:border-zinc-700/60 dark:text-zinc-600' + (bgClass ? ' ' + bgClass : '');
          tdNumA.textContent = row.lineA != null ? String(row.lineA) : '';

          // Line number B
          tdNumB.className = 'w-10 min-w-[2.5rem] select-none border-r border-zinc-200 px-2 py-0.5 text-right text-xs tabular-nums text-zinc-400 dark:border-zinc-700/60 dark:text-zinc-600' + (bgClass ? ' ' + bgClass : '');
          tdNumB.textContent = row.lineB != null ? String(row.lineB) : '';

          // Sign
          tdSign.className = 'w-6 select-none px-1 py-0.5 text-center text-xs font-bold ' + (signColor || 'text-zinc-400 dark:text-zinc-600') + (bgClass ? ' ' + bgClass : '');
          tdSign.textContent = signChar;

          // Code content
          tdCode.className = 'w-full py-0.5 pr-4 pl-1 text-xs text-zinc-800 dark:text-zinc-200' + (bgClass ? ' ' + bgClass : '');
          tdCode.textContent = row.text; // safe: textContent, never innerHTML

          tr.appendChild(tdNumA);
          tr.appendChild(tdNumB);
          tr.appendChild(tdSign);
          tr.appendChild(tdCode);
        }

        tbody.appendChild(tr);
      }

      diffTable.appendChild(tbody);
      diffPlaceholder.classList.add('hidden');
      diffTableWrap.classList.remove('hidden');
    }

    function showPlaceholder(msg) {
      diffPlaceholder.textContent = msg;
      diffPlaceholder.classList.remove('hidden');
      diffTableWrap.classList.add('hidden');
    }

    // ─── Debounce ─────────────────────────────────────────────────────────────
    let debounceTimer = null;
    function scheduleCompare() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(runDiff, 300);
    }

    // ─── Event listeners ──────────────────────────────────────────────────────
    taLeft.addEventListener('input', scheduleCompare);
    taRight.addEventListener('input', scheduleCompare);

    btnCompare.addEventListener('click', () => {
      clearTimeout(debounceTimer);
      runDiff();
    });

    btnSwap.addEventListener('click', () => {
      const tmp = taLeft.value;
      taLeft.value = taRight.value;
      taRight.value = tmp;
      clearTimeout(debounceTimer);
      runDiff();
    });

    btnClear.addEventListener('click', () => {
      taLeft.value = '';
      taRight.value = '';
      clearTimeout(debounceTimer);
      showPlaceholder(copy.empty);
      statsBar.classList.add('hidden');
    });
  </script>

</ToolPageLayout>
