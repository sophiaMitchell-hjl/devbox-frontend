---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { getClusterArticles, splitByTier, TYPE_LABEL } from '../../lib/articles';
import { localePaths, langOfParam, localePath } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const articles = await getClusterArticles('regex', lang);
const tierLabels =
  lang === 'en'
    ? { core: 'Start here', advanced: 'Advanced · reference as needed' }
    : { core: '入门必看', advanced: '进阶 · 按需查阅' };
const { core, advanced } = splitByTier(articles);
const tiers = [
  { label: tierLabels.core, items: core },
  { label: tierLabels.advanced, items: advanced },
];
const deepDiveHeading = lang === 'en' ? 'Learn more about regex' : '深入了解正则';

const copy = {
  zh: {
    title: '正则表达式测试器 - 在线实时高亮匹配与分组 | DevBox',
    description:
      '在线正则表达式测试:实时高亮匹配、查看分组与命名组,内置邮箱/URL/IP/手机号等常用模板。浏览器本地运行,含 ReDoS 超时防护,可验证 AI 写的正则。',
    flags: [
      { f: 'g', label: 'g 全局', checked: true },
      { f: 'i', label: 'i 忽略大小写', checked: false },
      { f: 'm', label: 'm 多行', checked: false },
      { f: 's', label: 's 点匹配换行', checked: false },
      { f: 'u', label: 'u Unicode', checked: false },
      { f: 'y', label: 'y 粘连', checked: false },
    ],
    templates: [
      { name: '邮箱', pattern: '[\\w.+-]+@[\\w-]+\\.[\\w.-]+' },
      { name: 'URL', pattern: 'https?://[^\\s]+' },
      { name: 'IPv4', pattern: '\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b' },
      { name: '手机号', pattern: '1[3-9]\\d{9}' },
      { name: '日期', pattern: '\\d{4}-\\d{2}-\\d{2}' },
      { name: '中文', pattern: '[\\u4e00-\\u9fa5]+' },
      { name: '数字', pattern: '-?\\d+(?:\\.\\d+)?' },
    ],
    patternLabel: '正则表达式',
    patternHint: '(可粘贴 AI 给的正则来验证)',
    testTextLabel: '测试文本',
    testTextDefault: '联系我们:hello@devbox.tools 或 admin@example.com,谢谢!',
    highlightLabel: '高亮结果',
    visualizeBtn: '可视化',
    hideBtn: '收起',
    faqs: [
      {
        q: '为什么我的正则很慢甚至卡住?',
        a: '某些写法(如嵌套量词 (a+)+)在特定输入下会发生"灾难性回溯"(ReDoS),导致耗时爆炸。本工具在独立线程运行正则并设有超时保护,超时会提示你,不会卡死页面。',
      },
      {
        q: '这里的正则语法和我的语言一致吗?',
        a: '本工具使用浏览器的 JavaScript 正则引擎。大部分语法与 PCRE/Python 通用,但少数特性(如部分环视、\\p{} 属性)在各语言间略有差异,复杂场景请以目标语言实测为准。',
      },
    ],
  },
  en: {
    title: 'Regex Tester - Live Match Highlighting & Groups Online | DevBox',
    description:
      'Online regex tester: highlight matches in real time, inspect capture and named groups, with built-in templates for email/URL/IP/phone and more. Runs locally in your browser with ReDoS timeout protection — perfect for verifying AI-written regex.',
    flags: [
      { f: 'g', label: 'g global', checked: true },
      { f: 'i', label: 'i ignore case', checked: false },
      { f: 'm', label: 'm multiline', checked: false },
      { f: 's', label: 's dotall', checked: false },
      { f: 'u', label: 'u Unicode', checked: false },
      { f: 'y', label: 'y sticky', checked: false },
    ],
    templates: [
      { name: 'Email', pattern: '[\\w.+-]+@[\\w-]+\\.[\\w.-]+' },
      { name: 'URL', pattern: 'https?://[^\\s]+' },
      { name: 'IPv4', pattern: '\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b' },
      { name: 'Phone', pattern: '1[3-9]\\d{9}' },
      { name: 'Date', pattern: '\\d{4}-\\d{2}-\\d{2}' },
      { name: 'CJK', pattern: '[\\u4e00-\\u9fa5]+' },
      { name: 'Number', pattern: '-?\\d+(?:\\.\\d+)?' },
    ],
    patternLabel: 'Regular expression',
    patternHint: '(paste an AI-generated regex here to verify it)',
    testTextLabel: 'Test string',
    testTextDefault: 'Contact us: hello@devbox.tools or admin@example.com, thanks!',
    highlightLabel: 'Highlighted result',
    visualizeBtn: 'Visualize',
    hideBtn: 'Hide',
    faqs: [
      {
        q: 'Why is my regex slow or even hanging?',
        a: 'Some patterns (such as nested quantifiers like (a+)+) can trigger "catastrophic backtracking" (ReDoS) on certain inputs, causing runtime to explode. This tool runs the regex in a separate thread with timeout protection — if it times out you get a warning and the page never freezes.',
      },
      {
        q: 'Is the regex syntax here the same as in my language?',
        a: "This tool uses the browser's JavaScript regex engine. Most syntax is shared with PCRE/Python, but a few features (such as certain lookarounds or \\p{} properties) differ slightly across languages — for complex cases, always test in your target language.",
      },
    ],
  },
}[lang];

const flags = copy.flags;
const templates = copy.templates;
const faqs = copy.faqs;

const defaultPattern = '[\\w.+-]+@[\\w-]+\\.[\\w.-]+';

const inputCls =
  'w-full rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="regex" title={copy.title} description={copy.description} faqs={faqs}>
  <!-- 模板 -->
  <div class="mb-4 flex flex-wrap gap-2">
    {
      templates.map((t) => (
        <button
          type="button"
          data-pattern={t.pattern}
          class="tpl-btn rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm text-zinc-600 transition-colors hover:border-violet-300 hover:text-violet-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-violet-700"
        >
          {t.name}
        </button>
      ))
    }
  </div>

  <!-- 正则输入 -->
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <label for="pattern" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
      {copy.patternLabel} <span class="font-normal text-zinc-400">{copy.patternHint}</span>
    </label>
    <div class="flex items-center gap-2 font-mono text-lg text-zinc-400">
      <span>/</span>
      <input id="pattern" type="text" spellcheck="false" autocomplete="off" value={defaultPattern} class={inputCls} />
      <span>/</span>
    </div>

    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
      {
        flags.map((fl) => (
          <label class="flex items-center gap-1.5 text-sm text-zinc-600 dark:text-zinc-300">
            <input type="checkbox" class="flag-box h-4 w-4 rounded border-zinc-300 accent-violet-600" data-flag={fl.f} checked={fl.checked} />
            {fl.label}
          </label>
        ))
      }
    </div>

    <div class="mt-3 border-t border-zinc-100 pt-3 dark:border-zinc-800">
      <button
        id="viz-btn"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-sm font-medium text-zinc-700 transition-colors hover:border-violet-300 hover:text-violet-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-violet-700 dark:hover:text-violet-400"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <rect x="1" y="5" width="3" height="4" rx="1"/>
          <rect x="5.5" y="2" width="3" height="10" rx="1"/>
          <rect x="10" y="4" width="3" height="6" rx="1"/>
        </svg>
        {copy.visualizeBtn}
      </button>
    </div>

    <p id="re-error" class="mt-3 hidden text-sm text-red-500"></p>
  </div>

  <!-- 可视化面板 -->
  <div id="viz-panel" class="mt-4 hidden rounded-2xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
    <div id="viz-svg" class="overflow-x-auto"></div>
  </div>

  <!-- 测试文本 -->
  <div class="mt-4">
    <label for="text" class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.testTextLabel}</label>
    <textarea id="text" class={`${inputCls} h-32`} spellcheck="false">{copy.testTextDefault}</textarea>
  </div>

  <!-- 高亮结果 -->
  <div class="mt-4">
    <div class="mb-1 flex items-center justify-between">
      <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.highlightLabel}</span>
      <span id="re-count" class="text-sm text-zinc-400"></span>
    </div>
    <div
      id="re-highlight"
      class="min-h-16 rounded-xl border border-zinc-200 bg-white p-4 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap text-zinc-800 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200"
    >
    </div>
  </div>

  <!-- 匹配详情 -->
  <div id="re-matches" class="mt-4 space-y-2"></div>

  <!-- 深入了解 -->
  <section class="mt-14">
    <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{deepDiveHeading}</h2>
    <div class="mt-4 space-y-6">
      {
        tiers.map(
          (g) =>
            g.items.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-zinc-400">{g.label}</p>
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                  {g.items.map((a) => (
                    <a
                      href={localePath(`/regex/${a.slug}`, lang)}
                      class="rounded-xl border border-zinc-200 bg-white p-4 transition-colors hover:border-violet-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
                    >
                      <span class="text-xs text-violet-500">{TYPE_LABEL[lang][a.type] ?? a.type}</span>
                      <span class="mt-1 block font-medium text-zinc-900 dark:text-white">{a.title}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
        )
      }
    </div>
  </section>

  <script>
    import RegexWorker from '../../workers/regex.worker.ts?worker';

    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      syntaxError: (msg: string) => (L === 'en' ? 'Regex syntax error: ' : '正则语法错误:') + msg,
      empty: L === 'en' ? '(empty)' : '(空)',
      count: (n: number) => (L === 'en' ? `${n} match${n === 1 ? '' : 'es'}` : `匹配 ${n} 处`),
      group: (n: number) => (L === 'en' ? `Group ${n}:` : `组${n}:`),
      more: (n: number) =>
        L === 'en' ? `Showing first 50 of ${n} matches` : `仅显示前 50 处,共 ${n} 处`,
      timeout:
        L === 'en'
          ? 'Match timed out: the regex may have catastrophic backtracking (ReDoS) — check nested quantifiers and similar patterns.'
          : '匹配超时:正则可能存在灾难性回溯(ReDoS),请检查嵌套量词等写法。',
      visualize: L === 'en' ? 'Visualize' : '可视化',
      hide: L === 'en' ? 'Hide' : '收起',
    };

    const patternEl = document.getElementById('pattern') as HTMLInputElement;
    const textEl = document.getElementById('text') as HTMLTextAreaElement;
    const flagBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.flag-box'));
    const errEl = document.getElementById('re-error')!;
    const highlightEl = document.getElementById('re-highlight')!;
    const countEl = document.getElementById('re-count')!;
    const matchesEl = document.getElementById('re-matches')!;
    const vizBtn = document.getElementById('viz-btn')!;
    const vizPanel = document.getElementById('viz-panel')!;
    const vizSvgEl = document.getElementById('viz-svg')!;

    interface RMatch {
      index: number;
      match: string;
      groups: (string | undefined)[];
      named: Record<string, string> | null;
    }

    let worker: Worker;
    let timer: ReturnType<typeof setTimeout>;
    let vizOpen = false;

    function spawn() {
      worker = new RegexWorker();
      worker.onmessage = (e: MessageEvent) => {
        clearTimeout(timer);
        const data = e.data as { ok: boolean; matches?: RMatch[]; error?: string };
        if (!data.ok) {
          showError(TXT.syntaxError(data.error || ''));
          return;
        }
        render(data.matches || []);
      };
    }

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    function readFlags() {
      return flagBoxes
        .filter((b) => b.checked)
        .map((b) => b.dataset.flag)
        .join('');
    }

    function showError(msg: string) {
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
      highlightEl.innerHTML = esc(textEl.value);
      countEl.textContent = '';
      matchesEl.innerHTML = '';
    }

    function render(matches: RMatch[]) {
      errEl.classList.add('hidden');
      const text = textEl.value;

      let html = '';
      let last = 0;
      for (const m of matches) {
        if (m.index < last || !m.match) continue;
        html += esc(text.slice(last, m.index));
        html += `<mark class="rounded bg-violet-200 px-0.5 text-violet-900 dark:bg-violet-500/40 dark:text-violet-50">${esc(m.match)}</mark>`;
        last = m.index + m.match.length;
      }
      html += esc(text.slice(last));
      highlightEl.innerHTML = html || `<span class="text-zinc-400">${TXT.empty}</span>`;

      countEl.textContent = TXT.count(matches.length);
      if (matches.length === 0) {
        matchesEl.innerHTML = '';
        return;
      }
      matchesEl.innerHTML = matches
        .slice(0, 50)
        .map((m, i) => {
          const groups = m.groups
            .map((g, gi) => `<span class="text-zinc-400">${TXT.group(gi + 1)}</span> ${g === undefined ? '—' : esc(g)}`)
            .join('　');
          const named = m.named
            ? Object.entries(m.named)
                .map(([k, v]) => `<span class="text-zinc-400">${esc(k)}:</span> ${esc(v ?? '')}`)
                .join('　')
            : '';
          return `<div class="rounded-lg border border-zinc-200 bg-white p-3 text-sm dark:border-zinc-800 dark:bg-zinc-900">
            <span class="font-mono font-medium text-violet-600 dark:text-violet-400">#${i + 1}</span>
            <span class="ml-2 font-mono text-zinc-800 dark:text-zinc-100">${esc(m.match)}</span>
            <span class="ml-2 text-xs text-zinc-400">@ ${m.index}</span>
            ${m.groups.length ? `<div class="mt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">${groups}</div>` : ''}
            ${named ? `<div class="mt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">${named}</div>` : ''}
          </div>`;
        })
        .join('');
      if (matches.length > 50) {
        matchesEl.innerHTML += `<p class="text-center text-xs text-zinc-400">${TXT.more(matches.length)}</p>`;
      }
    }

    function evaluate() {
      const pattern = patternEl.value;
      if (!pattern) {
        errEl.classList.add('hidden');
        highlightEl.innerHTML = esc(textEl.value);
        countEl.textContent = '';
        matchesEl.innerHTML = '';
        return;
      }
      clearTimeout(timer);
      worker.postMessage({ pattern, flags: readFlags(), text: textEl.value });
      timer = setTimeout(() => {
        worker.terminate();
        spawn();
        showError(TXT.timeout);
      }, 1000);

      if (vizOpen) updateViz(pattern);
    }

    patternEl.addEventListener('input', evaluate);
    textEl.addEventListener('input', evaluate);
    flagBoxes.forEach((b) => b.addEventListener('change', evaluate));
    document.querySelectorAll<HTMLButtonElement>('.tpl-btn').forEach((b) =>
      b.addEventListener('click', () => {
        patternEl.value = b.dataset.pattern!;
        evaluate();
      })
    );

    spawn();
    evaluate();

    // ── Visualize toggle ──────────────────────────────────────────────────────
    vizBtn.addEventListener('click', () => {
      vizOpen = !vizOpen;
      if (vizOpen) {
        vizPanel.classList.remove('hidden');
        updateViz(patternEl.value);
        const icon = vizBtn.querySelector('svg')!;
        vizBtn.innerHTML = icon.outerHTML + ' ' + TXT.hide;
      } else {
        vizPanel.classList.add('hidden');
        const icon = vizBtn.querySelector('svg')!;
        vizBtn.innerHTML = icon.outerHTML + ' ' + TXT.visualize;
      }
    });

    function updateViz(pattern: string) {
      if (!pattern) { vizSvgEl.innerHTML = ''; return; }
      const isDark = document.documentElement.classList.contains('dark');
      const svg = buildRailroadSVG(pattern, isDark);
      vizSvgEl.innerHTML = svg ?? `<p style="font-size:13px;color:#71717a;padding:8px 0">${L === 'en' ? 'Could not visualize this pattern.' : '无法可视化此正则。'}</p>`;
    }

    // ── Railroad Diagram ──────────────────────────────────────────────────────
    const RR_CHAR_W    = 7.5;
    const RR_PAD_X     = 12;
    const RR_NODE_H    = 28;
    const RR_H_GAP     = 16;
    const RR_V_GAP     = 20;
    const RR_FORK_W    = 24;
    const RR_LOOP_H    = 24;
    const RR_GPX       = 16;
    const RR_GPY       = 10;
    const RR_LABEL_H   = 20;
    const RR_CORNER_R  = 6;

    type RRNode =
      | { type: 'literal' | 'escape' | 'dot' | 'anchor' | 'charclass'; label: string; _lyt?: any }
      | { type: 'empty'; _lyt?: any }
      | { type: 'seq'; children: RRNode[]; _lyt?: any; _cl?: any[] }
      | { type: 'alt'; children: RRNode[]; _lyt?: any; _cl?: any[]; _offs?: number[] }
      | { type: 'group'; label: string; inner: RRNode; _lyt?: any; _il?: any }
      | { type: 'quant'; label: string; inner: RRNode; _lyt?: any; _il?: any };

    function rrParseRegex(src: string): RRNode {
      let pos = 0;

      function parseAlt(): RRNode {
        const alts: RRNode[] = [parseSeq()];
        while (pos < src.length && src[pos] === '|') { pos++; alts.push(parseSeq()); }
        return alts.length === 1 ? alts[0] : { type: 'alt', children: alts };
      }

      function parseSeq(): RRNode {
        const items: RRNode[] = [];
        while (pos < src.length && src[pos] !== '|' && src[pos] !== ')') {
          const n = parseAtom();
          if (n) items.push(n);
        }
        if (items.length === 0) return { type: 'empty' };
        if (items.length === 1) return items[0];
        return { type: 'seq', children: items };
      }

      function parseAtom(): RRNode | null {
        if (pos >= src.length) return null;
        const ch = src[pos];
        let node: RRNode | null = null;

        if (ch === '(') {
          pos++;
          let label = 'group';
          if (pos < src.length && src[pos] === '?') {
            pos++;
            const nxt = src[pos] ?? '';
            if (nxt === ':') { pos++; label = '(?:)'; }
            else if (nxt === '=') { pos++; label = '(?=)'; }
            else if (nxt === '!') { pos++; label = '(?!)'; }
            else if (nxt === '<') {
              pos++;
              const nxt2 = src[pos] ?? '';
              if (nxt2 === '=') { pos++; label = '(?<=)'; }
              else if (nxt2 === '!') { pos++; label = '(?<!)'; }
              else {
                let name = '';
                while (pos < src.length && src[pos] !== '>') name += src[pos++];
                if (src[pos] === '>') pos++;
                label = name || 'group';
              }
            } else { pos--; }
          }
          const inner = parseAlt();
          if (pos < src.length && src[pos] === ')') pos++;
          node = { type: 'group', label, inner };
        } else if (ch === '[') {
          let cls = '[';
          pos++;
          if (pos < src.length && src[pos] === '^') { cls += '^'; pos++; }
          while (pos < src.length && src[pos] !== ']') {
            if (src[pos] === '\\') { cls += src[pos] + (src[pos + 1] ?? ''); pos += 2; }
            else cls += src[pos++];
          }
          cls += ']';
          if (pos < src.length && src[pos] === ']') pos++;
          if (cls.length > 14) cls = cls.slice(0, 12) + '…]';
          node = { type: 'charclass', label: cls };
        } else if (ch === '\\') {
          pos++;
          const e = src[pos++] ?? '';
          node = { type: 'escape', label: '\\' + e };
        } else if (ch === '^' || ch === '$') {
          pos++;
          node = { type: 'anchor', label: ch };
        } else if (ch === '.') {
          pos++;
          node = { type: 'dot', label: '.' };
        } else if (ch === '*' || ch === '+' || ch === '?' || ch === '{') {
          if (ch === '{') { while (pos < src.length && src[pos] !== '}') pos++; if (pos < src.length) pos++; }
          else pos++;
          return null;
        } else {
          pos++;
          node = { type: 'literal', label: ch };
        }

        if (node && pos < src.length) {
          const qch = src[pos];
          let q: string | null = null;
          if (qch === '*' || qch === '+' || qch === '?') { q = qch; pos++; }
          else if (qch === '{') {
            let qstr = '{';
            pos++;
            while (pos < src.length && src[pos] !== '}') qstr += src[pos++];
            qstr += '}';
            if (pos < src.length && src[pos] === '}') pos++;
            q = qstr;
          }
          if (q !== null) {
            if (pos < src.length && src[pos] === '?') { q += '?'; pos++; }
            node = { type: 'quant', label: q, inner: node };
          }
        }
        return node;
      }

      return parseAlt();
    }

    interface Lyt { w: number; h: number; ry: number }

    function rrLayout(node: RRNode): Lyt {
      switch (node.type) {
        case 'literal': case 'escape': case 'dot': case 'anchor': case 'charclass': {
          const tw = node.label.length * RR_CHAR_W + RR_PAD_X * 2;
          const w = Math.max(tw, 32);
          const lyt: Lyt = { w, h: RR_NODE_H, ry: RR_NODE_H / 2 };
          (node as any)._lyt = lyt;
          return lyt;
        }
        case 'empty': {
          const lyt: Lyt = { w: 12, h: RR_NODE_H, ry: RR_NODE_H / 2 };
          (node as any)._lyt = lyt;
          return lyt;
        }
        case 'seq': {
          const cl = node.children.map(rrLayout);
          node._cl = cl;
          const totalW = cl.reduce((s, l) => s + l.w, 0) + RR_H_GAP * (cl.length - 1);
          const ry = Math.max(...cl.map((l) => l.ry));
          const bot = Math.max(...cl.map((l) => l.h - l.ry));
          const lyt: Lyt = { w: totalW, h: ry + bot, ry };
          (node as any)._lyt = lyt;
          return lyt;
        }
        case 'alt': {
          const cl = node.children.map(rrLayout);
          node._cl = cl;
          const maxW = Math.max(...cl.map((l) => l.w));
          const w = maxW + RR_FORK_W * 2;
          let h = 0;
          const offs: number[] = [];
          for (let i = 0; i < cl.length; i++) {
            offs.push(h);
            h += cl[i].h + (i < cl.length - 1 ? RR_V_GAP : 0);
          }
          node._offs = offs;
          const ry = offs[0] + cl[0].ry;
          const lyt: Lyt = { w, h, ry };
          (node as any)._lyt = lyt;
          return lyt;
        }
        case 'group': {
          const il = rrLayout(node.inner);
          node._il = il;
          const labelW = node.label.length * RR_CHAR_W + RR_PAD_X * 2;
          const innerW = Math.max(il.w, labelW - RR_GPX * 2);
          const w = innerW + RR_GPX * 2;
          const h = il.h + RR_GPY * 2 + RR_LABEL_H;
          const ry = RR_LABEL_H + RR_GPY + il.ry;
          const lyt: Lyt = { w, h, ry };
          (node as any)._lyt = lyt;
          (node as any)._innerW = innerW;
          return lyt;
        }
        case 'quant': {
          const il = rrLayout(node.inner);
          node._il = il;
          const w = il.w + RR_FORK_W * 2;
          const h = il.h + RR_LOOP_H;
          const ry = RR_LOOP_H + il.ry;
          const lyt: Lyt = { w, h, ry };
          (node as any)._lyt = lyt;
          return lyt;
        }
      }
    }

    interface Colors {
      fill: string; stroke: string; text: string; line: string;
      accentFill: string; accentStroke: string;
      groupStroke: string; loopColor: string; bg: string;
    }

    function rrRender(node: RRNode, lyt: Lyt, x: number, y: number, out: string[], C: Colors): void {
      const ry = y + lyt.ry;

      switch (node.type) {
        case 'literal': case 'escape': case 'dot': {
          const bx = x, by = ry - RR_NODE_H / 2, bw = lyt.w, bh = RR_NODE_H;
          out.push(`<rect x="${f(bx)}" y="${f(by)}" width="${f(bw)}" height="${f(bh)}" rx="${RR_CORNER_R}" fill="${C.fill}" stroke="${C.stroke}" stroke-width="1.5"/>`);
          out.push(`<text x="${f(bx + bw / 2)}" y="${f(by + bh / 2 + 4.5)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="12" fill="${C.text}">${rrEsc(node.label)}</text>`);
          break;
        }
        case 'anchor': {
          const bx = x, by = ry - RR_NODE_H / 2, bw = lyt.w, bh = RR_NODE_H;
          out.push(`<rect x="${f(bx)}" y="${f(by)}" width="${f(bw)}" height="${f(bh)}" rx="${bh / 2}" fill="${C.accentFill}" stroke="${C.accentStroke}" stroke-width="1.5"/>`);
          out.push(`<text x="${f(bx + bw / 2)}" y="${f(by + bh / 2 + 4.5)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="12" font-weight="600" fill="${C.accentStroke}">${rrEsc(node.label)}</text>`);
          break;
        }
        case 'charclass': {
          const bx = x, by = ry - RR_NODE_H / 2, bw = lyt.w, bh = RR_NODE_H;
          out.push(`<rect x="${f(bx)}" y="${f(by)}" width="${f(bw)}" height="${f(bh)}" rx="${RR_CORNER_R}" fill="${C.fill}" stroke="${C.groupStroke}" stroke-width="1.5" stroke-dasharray="3,2"/>`);
          out.push(`<text x="${f(bx + bw / 2)}" y="${f(by + bh / 2 + 4.5)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="12" fill="${C.groupStroke}">${rrEsc(node.label)}</text>`);
          break;
        }
        case 'empty': {
          out.push(`<line x1="${f(x)}" y1="${f(ry)}" x2="${f(x + lyt.w)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);
          break;
        }
        case 'seq': {
          const cl = (node as any)._cl as Lyt[];
          let cx = x;
          for (let i = 0; i < node.children.length; i++) {
            const cl_ = cl[i];
            const childY = y + lyt.ry - cl_.ry;
            rrRender(node.children[i], cl_, cx, childY, out, C);
            if (i < node.children.length - 1) {
              const rx2 = cx + cl_.w;
              out.push(`<line x1="${f(rx2)}" y1="${f(ry)}" x2="${f(rx2 + RR_H_GAP)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5" marker-end="url(#rr-arrow)"/>`);
              cx += cl_.w + RR_H_GAP;
            }
          }
          break;
        }
        case 'alt': {
          const cl = (node as any)._cl as Lyt[];
          const offs = (node as any)._offs as number[];
          const maxW = Math.max(...cl.map((l) => l.w));
          const forkLX = x + RR_FORK_W / 2;
          const forkRX = x + lyt.w - RR_FORK_W / 2;
          const topRY = y + offs[0] + cl[0].ry;
          const botRY = y + offs[cl.length - 1] + cl[cl.length - 1].ry;

          if (cl.length > 1) {
            out.push(`<line x1="${f(forkLX)}" y1="${f(topRY)}" x2="${f(forkLX)}" y2="${f(botRY)}" stroke="${C.line}" stroke-width="1.5"/>`);
            out.push(`<line x1="${f(forkRX)}" y1="${f(topRY)}" x2="${f(forkRX)}" y2="${f(botRY)}" stroke="${C.line}" stroke-width="1.5"/>`);
          }
          out.push(`<line x1="${f(x)}" y1="${f(ry)}" x2="${f(forkLX)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);
          out.push(`<line x1="${f(forkRX)}" y1="${f(ry)}" x2="${f(x + lyt.w)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);

          for (let i = 0; i < cl.length; i++) {
            const branchY = y + offs[i];
            const branchRY = branchY + cl[i].ry;
            const branchX = x + RR_FORK_W + (maxW - cl[i].w) / 2;
            rrRender(node.children[i], cl[i], branchX, branchY, out, C);
            out.push(`<line x1="${f(forkLX)}" y1="${f(branchRY)}" x2="${f(branchX)}" y2="${f(branchRY)}" stroke="${C.line}" stroke-width="1.5"/>`);
            out.push(`<line x1="${f(branchX + cl[i].w)}" y1="${f(branchRY)}" x2="${f(forkRX)}" y2="${f(branchRY)}" stroke="${C.line}" stroke-width="1.5"/>`);
          }
          break;
        }
        case 'group': {
          const il = (node as any)._il as Lyt;
          const innerW: number = (node as any)._innerW ?? il.w;
          const innerRenderX = x + (lyt.w - innerW) / 2;
          const innerY = y + RR_LABEL_H + RR_GPY;

          out.push(`<rect x="${f(x + 1)}" y="${f(y + RR_LABEL_H + 1)}" width="${f(lyt.w - 2)}" height="${f(lyt.h - RR_LABEL_H - 2)}" rx="8" fill="none" stroke="${C.groupStroke}" stroke-width="1.5" stroke-dasharray="4,3" opacity="0.65"/>`);
          const labelPxW = node.label.length * RR_CHAR_W + 12;
          out.push(`<rect x="${f(x + 8)}" y="${f(y + 1)}" width="${f(labelPxW)}" height="${RR_LABEL_H - 2}" rx="4" fill="${C.groupStroke}" opacity="0.18"/>`);
          out.push(`<text x="${f(x + 8 + labelPxW / 2)}" y="${f(y + RR_LABEL_H - 5)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="10" fill="${C.groupStroke}">${rrEsc(node.label)}</text>`);

          rrRender(node.inner, { ...il, w: innerW }, innerRenderX, innerY, out, C);

          out.push(`<line x1="${f(x)}" y1="${f(ry)}" x2="${f(innerRenderX)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);
          out.push(`<line x1="${f(innerRenderX + innerW)}" y1="${f(ry)}" x2="${f(x + lyt.w)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);
          break;
        }
        case 'quant': {
          const il = (node as any)._il as Lyt;
          const innerX = x + RR_FORK_W;
          const innerY = y + RR_LOOP_H;

          rrRender(node.inner, il, innerX, innerY, out, C);

          out.push(`<line x1="${f(x)}" y1="${f(ry)}" x2="${f(innerX)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);
          out.push(`<line x1="${f(innerX + il.w)}" y1="${f(ry)}" x2="${f(x + lyt.w)}" y2="${f(ry)}" stroke="${C.line}" stroke-width="1.5"/>`);

          const loopTopY = y + 5;
          const loopLX = x + RR_FORK_W / 2;
          const loopRX = x + lyt.w - RR_FORK_W / 2;
          const midLoopY = loopTopY + (ry - loopTopY) / 2;

          out.push(`<line x1="${f(loopRX)}" y1="${f(ry)}" x2="${f(loopRX)}" y2="${f(loopTopY)}" stroke="${C.loopColor}" stroke-width="1.5"/>`);
          out.push(`<line x1="${f(loopRX)}" y1="${f(loopTopY)}" x2="${f(loopLX)}" y2="${f(loopTopY)}" stroke="${C.loopColor}" stroke-width="1.5" marker-end="url(#rr-loop-arrow)"/>`);
          out.push(`<line x1="${f(loopLX)}" y1="${f(loopTopY)}" x2="${f(loopLX)}" y2="${f(ry)}" stroke="${C.loopColor}" stroke-width="1.5"/>`);
          out.push(`<text x="${f((loopLX + loopRX) / 2)}" y="${f(midLoopY + 4)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="10" fill="${C.loopColor}">${rrEsc(node.label)}</text>`);
          break;
        }
      }
    }

    function f(n: number) { return Math.round(n * 10) / 10; }
    function rrEsc(s: string) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function buildRailroadSVG(pattern: string, isDark: boolean): string | null {
      let ast: RRNode;
      try { ast = rrParseRegex(pattern); } catch { return null; }

      let lyt: Lyt;
      try { lyt = rrLayout(ast); } catch { return null; }

      const C: Colors = isDark
        ? { bg: 'transparent', fill: '#3f3f46', stroke: '#71717a', text: '#e4e4e7',
            line: '#71717a', accentFill: '#4c1d95', accentStroke: '#a78bfa',
            groupStroke: '#a78bfa', loopColor: '#c4b5fd' }
        : { bg: 'transparent', fill: '#f4f4f5', stroke: '#a1a1aa', text: '#3f3f46',
            line: '#71717a', accentFill: '#ede9fe', accentStroke: '#7c3aed',
            groupStroke: '#7c3aed', loopColor: '#7c3aed' };

      const MARGIN = 28;
      const TERM_R = 5;
      const RAIL_W = 16;
      const totalW = lyt.w + MARGIN * 2 + RAIL_W * 2;
      const totalH = lyt.h + MARGIN * 2;
      const railY = MARGIN + lyt.ry;
      const nodeX = MARGIN + RAIL_W;
      const nodeY = MARGIN;

      const out: string[] = [];

      out.push(`<defs>
  <marker id="rr-arrow" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
    <polygon points="0 0,7 2.5,0 5" fill="${C.line}"/>
  </marker>
  <marker id="rr-loop-arrow" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
    <polygon points="0 0,7 2.5,0 5" fill="${C.loopColor}"/>
  </marker>
</defs>`);

      out.push(`<circle cx="${f(MARGIN + TERM_R)}" cy="${f(railY)}" r="${TERM_R}" fill="${C.line}"/>`);
      out.push(`<line x1="${f(MARGIN + TERM_R * 2)}" y1="${f(railY)}" x2="${f(nodeX)}" y2="${f(railY)}" stroke="${C.line}" stroke-width="1.5"/>`);
      const endX = nodeX + lyt.w;
      out.push(`<line x1="${f(endX)}" y1="${f(railY)}" x2="${f(endX + RAIL_W - TERM_R * 2)}" y2="${f(railY)}" stroke="${C.line}" stroke-width="1.5"/>`);
      out.push(`<circle cx="${f(endX + RAIL_W - TERM_R)}" cy="${f(railY)}" r="${TERM_R}" fill="${C.line}"/>`);
      out.push(`<circle cx="${f(endX + RAIL_W - TERM_R)}" cy="${f(railY)}" r="${TERM_R - 2}" fill="${isDark ? '#18181b' : '#ffffff'}"/>`);

      rrRender(ast, lyt, nodeX, nodeY, out, C);

      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${f(totalW)} ${f(totalH)}" style="max-width:100%;display:block;min-width:120px">\n${out.join('\n')}\n</svg>`;
    }
  </script>
</ToolPageLayout>
