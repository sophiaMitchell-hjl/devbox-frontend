---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { getClusterArticles, splitByTier, TYPE_LABEL } from '../../lib/articles';
import { localePaths, langOfParam, localePath } from '../../i18n';

export const getStaticPaths = localePaths;
const lang = langOfParam(Astro.params.loc);

const articles = await getClusterArticles('regex', lang);
const tierLabels =
  lang === 'en'
    ? { core: 'Start here', advanced: 'Advanced · reference as needed' }
    : { core: '入门必看', advanced: '进阶 · 按需查阅' };
const tiers = [
  { label: tierLabels.core, items: splitByTier(articles).core },
  { label: tierLabels.advanced, items: splitByTier(articles).advanced },
];
const deepDiveHeading = lang === 'en' ? 'Learn more about regex' : '深入了解正则';

const copy = {
  zh: {
    title: '正则表达式测试器 - 在线实时高亮匹配与分组 | DevBox',
    description:
      '在线正则表达式测试:实时高亮匹配、查看分组与命名组,内置邮箱/URL/IP/手机号等常用模板。浏览器本地运行,含 ReDoS 超时防护,可验证 AI 写的正则。',
    flags: [
      { f: 'g', label: 'g 全局', checked: true },
      { f: 'i', label: 'i 忽略大小写', checked: false },
      { f: 'm', label: 'm 多行', checked: false },
      { f: 's', label: 's 点匹配换行', checked: false },
      { f: 'u', label: 'u Unicode', checked: false },
      { f: 'y', label: 'y 粘连', checked: false },
    ],
    templates: [
      { name: '邮箱', pattern: '[\\w.+-]+@[\\w-]+\\.[\\w.-]+' },
      { name: 'URL', pattern: 'https?://[^\\s]+' },
      { name: 'IPv4', pattern: '\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b' },
      { name: '手机号', pattern: '1[3-9]\\d{9}' },
      { name: '日期', pattern: '\\d{4}-\\d{2}-\\d{2}' },
      { name: '中文', pattern: '[\\u4e00-\\u9fa5]+' },
      { name: '数字', pattern: '-?\\d+(?:\\.\\d+)?' },
    ],
    patternLabel: '正则表达式',
    patternHint: '(可粘贴 AI 给的正则来验证)',
    testTextLabel: '测试文本',
    testTextDefault: '联系我们:hello@devbox.tools 或 admin@example.com,谢谢!',
    highlightLabel: '高亮结果',
    faqs: [
      {
        q: '为什么我的正则很慢甚至卡住?',
        a: '某些写法(如嵌套量词 (a+)+)在特定输入下会发生"灾难性回溯"(ReDoS),导致耗时爆炸。本工具在独立线程运行正则并设有超时保护,超时会提示你,不会卡死页面。',
      },
      {
        q: '这里的正则语法和我的语言一致吗?',
        a: '本工具使用浏览器的 JavaScript 正则引擎。大部分语法与 PCRE/Python 通用,但少数特性(如部分环视、\\p{} 属性)在各语言间略有差异,复杂场景请以目标语言实测为准。',
      },
    ],
  },
  en: {
    title: 'Regex Tester - Live Match Highlighting & Groups Online | DevBox',
    description:
      'Online regex tester: highlight matches in real time, inspect capture and named groups, with built-in templates for email/URL/IP/phone and more. Runs locally in your browser with ReDoS timeout protection — perfect for verifying AI-written regex.',
    flags: [
      { f: 'g', label: 'g global', checked: true },
      { f: 'i', label: 'i ignore case', checked: false },
      { f: 'm', label: 'm multiline', checked: false },
      { f: 's', label: 's dotall', checked: false },
      { f: 'u', label: 'u Unicode', checked: false },
      { f: 'y', label: 'y sticky', checked: false },
    ],
    templates: [
      { name: 'Email', pattern: '[\\w.+-]+@[\\w-]+\\.[\\w.-]+' },
      { name: 'URL', pattern: 'https?://[^\\s]+' },
      { name: 'IPv4', pattern: '\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b' },
      { name: 'Phone', pattern: '1[3-9]\\d{9}' },
      { name: 'Date', pattern: '\\d{4}-\\d{2}-\\d{2}' },
      { name: 'CJK', pattern: '[\\u4e00-\\u9fa5]+' },
      { name: 'Number', pattern: '-?\\d+(?:\\.\\d+)?' },
    ],
    patternLabel: 'Regular expression',
    patternHint: '(paste an AI-generated regex here to verify it)',
    testTextLabel: 'Test string',
    testTextDefault: 'Contact us: hello@devbox.tools or admin@example.com, thanks!',
    highlightLabel: 'Highlighted result',
    faqs: [
      {
        q: 'Why is my regex slow or even hanging?',
        a: 'Some patterns (such as nested quantifiers like (a+)+) can trigger "catastrophic backtracking" (ReDoS) on certain inputs, causing runtime to explode. This tool runs the regex in a separate thread with timeout protection — if it times out you get a warning and the page never freezes.',
      },
      {
        q: 'Is the regex syntax here the same as in my language?',
        a: "This tool uses the browser's JavaScript regex engine. Most syntax is shared with PCRE/Python, but a few features (such as certain lookarounds or \\p{} properties) differ slightly across languages — for complex cases, always test in your target language.",
      },
    ],
  },
}[lang];

const flags = copy.flags;
const templates = copy.templates;
const faqs = copy.faqs;

const defaultPattern = '[\\w.+-]+@[\\w-]+\\.[\\w.-]+';

const inputCls =
  'w-full rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="regex" title={copy.title} description={copy.description} faqs={faqs}>
  <!-- 模板 -->
  <div class="mb-4 flex flex-wrap gap-2">
    {
      templates.map((t) => (
        <button
          type="button"
          data-pattern={t.pattern}
          class="tpl-btn rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm text-zinc-600 transition-colors hover:border-violet-300 hover:text-violet-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-violet-700"
        >
          {t.name}
        </button>
      ))
    }
  </div>

  <!-- 正则输入 -->
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <label for="pattern" class="mb-2 block text-sm font-medium text-zinc-700 dark:text-zinc-300">
      {copy.patternLabel} <span class="font-normal text-zinc-400">{copy.patternHint}</span>
    </label>
    <div class="flex items-center gap-2 font-mono text-lg text-zinc-400">
      <span>/</span>
      <input id="pattern" type="text" spellcheck="false" autocomplete="off" value={defaultPattern} class={inputCls} />
      <span>/</span>
    </div>

    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
      {
        flags.map((fl) => (
          <label class="flex items-center gap-1.5 text-sm text-zinc-600 dark:text-zinc-300">
            <input type="checkbox" class="flag-box h-4 w-4 rounded border-zinc-300 accent-violet-600" data-flag={fl.f} checked={fl.checked} />
            {fl.label}
          </label>
        ))
      }
    </div>

    <p id="re-error" class="mt-3 hidden text-sm text-red-500"></p>
  </div>

  <!-- 测试文本 -->
  <div class="mt-4">
    <label for="text" class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.testTextLabel}</label>
    <textarea id="text" class={`${inputCls} h-32`} spellcheck="false">{copy.testTextDefault}</textarea>
  </div>

  <!-- 高亮结果 -->
  <div class="mt-4">
    <div class="mb-1 flex items-center justify-between">
      <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{copy.highlightLabel}</span>
      <span id="re-count" class="text-sm text-zinc-400"></span>
    </div>
    <div
      id="re-highlight"
      class="min-h-16 rounded-xl border border-zinc-200 bg-white p-4 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap text-zinc-800 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-200"
    >
    </div>
  </div>

  <!-- 匹配详情 -->
  <div id="re-matches" class="mt-4 space-y-2"></div>

  <!-- 深入了解 -->
  <section class="mt-14">
    <h2 class="text-xl font-semibold text-zinc-900 dark:text-white">{deepDiveHeading}</h2>
    <div class="mt-4 space-y-6">
      {
        tiers.map(
          (g) =>
            g.items.length > 0 && (
              <div>
                <p class="text-xs font-medium uppercase tracking-wide text-zinc-400">{g.label}</p>
                <div class="mt-2 grid gap-3 sm:grid-cols-2">
                  {g.items.map((a) => (
                    <a
                      href={localePath(`/regex/${a.slug}`, lang)}
                      class="rounded-xl border border-zinc-200 bg-white p-4 transition-colors hover:border-violet-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700"
                    >
                      <span class="text-xs text-violet-500">{TYPE_LABEL[lang][a.type] ?? a.type}</span>
                      <span class="mt-1 block font-medium text-zinc-900 dark:text-white">{a.title}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
        )
      }
    </div>
  </section>

  <script>
    import RegexWorker from '../../workers/regex.worker.ts?worker';

    const L = document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    const TXT = {
      syntaxError: (msg: string) => (L === 'en' ? 'Regex syntax error: ' : '正则语法错误:') + msg,
      empty: L === 'en' ? '(empty)' : '(空)',
      count: (n: number) => (L === 'en' ? `${n} match${n === 1 ? '' : 'es'}` : `匹配 ${n} 处`),
      group: (n: number) => (L === 'en' ? `Group ${n}:` : `组${n}:`),
      more: (n: number) =>
        L === 'en' ? `Showing first 50 of ${n} matches` : `仅显示前 50 处,共 ${n} 处`,
      timeout:
        L === 'en'
          ? 'Match timed out: the regex may have catastrophic backtracking (ReDoS) — check nested quantifiers and similar patterns.'
          : '匹配超时:正则可能存在灾难性回溯(ReDoS),请检查嵌套量词等写法。',
    };

    const patternEl = document.getElementById('pattern') as HTMLInputElement;
    const textEl = document.getElementById('text') as HTMLTextAreaElement;
    const flagBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.flag-box'));
    const errEl = document.getElementById('re-error')!;
    const highlightEl = document.getElementById('re-highlight')!;
    const countEl = document.getElementById('re-count')!;
    const matchesEl = document.getElementById('re-matches')!;

    interface RMatch {
      index: number;
      match: string;
      groups: (string | undefined)[];
      named: Record<string, string> | null;
    }

    let worker: Worker;
    let timer: ReturnType<typeof setTimeout>;

    function spawn() {
      worker = new RegexWorker();
      worker.onmessage = (e: MessageEvent) => {
        clearTimeout(timer);
        const data = e.data as { ok: boolean; matches?: RMatch[]; error?: string };
        if (!data.ok) {
          showError(TXT.syntaxError(data.error || ''));
          return;
        }
        render(data.matches || []);
      };
    }

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    function readFlags() {
      return flagBoxes
        .filter((b) => b.checked)
        .map((b) => b.dataset.flag)
        .join('');
    }

    function showError(msg: string) {
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
      highlightEl.innerHTML = esc(textEl.value);
      countEl.textContent = '';
      matchesEl.innerHTML = '';
    }

    function render(matches: RMatch[]) {
      errEl.classList.add('hidden');
      const text = textEl.value;

      // 高亮
      let html = '';
      let last = 0;
      for (const m of matches) {
        if (m.index < last || !m.match) continue; // 跳过重叠/零长度
        html += esc(text.slice(last, m.index));
        html += `<mark class="rounded bg-violet-200 px-0.5 text-violet-900 dark:bg-violet-500/40 dark:text-violet-50">${esc(m.match)}</mark>`;
        last = m.index + m.match.length;
      }
      html += esc(text.slice(last));
      highlightEl.innerHTML = html || `<span class="text-zinc-400">${TXT.empty}</span>`;

      // 计数 + 详情
      countEl.textContent = TXT.count(matches.length);
      if (matches.length === 0) {
        matchesEl.innerHTML = '';
        return;
      }
      matchesEl.innerHTML = matches
        .slice(0, 50)
        .map((m, i) => {
          const groups = m.groups
            .map((g, gi) => `<span class="text-zinc-400">${TXT.group(gi + 1)}</span> ${g === undefined ? '—' : esc(g)}`)
            .join('　');
          const named = m.named
            ? Object.entries(m.named)
                .map(([k, v]) => `<span class="text-zinc-400">${esc(k)}:</span> ${esc(v ?? '')}`)
                .join('　')
            : '';
          return `<div class="rounded-lg border border-zinc-200 bg-white p-3 text-sm dark:border-zinc-800 dark:bg-zinc-900">
            <span class="font-mono font-medium text-violet-600 dark:text-violet-400">#${i + 1}</span>
            <span class="ml-2 font-mono text-zinc-800 dark:text-zinc-100">${esc(m.match)}</span>
            <span class="ml-2 text-xs text-zinc-400">@ ${m.index}</span>
            ${m.groups.length ? `<div class="mt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">${groups}</div>` : ''}
            ${named ? `<div class="mt-1 font-mono text-xs text-zinc-500 dark:text-zinc-400">${named}</div>` : ''}
          </div>`;
        })
        .join('');
      if (matches.length > 50) {
        matchesEl.innerHTML += `<p class="text-center text-xs text-zinc-400">${TXT.more(matches.length)}</p>`;
      }
    }

    function evaluate() {
      const pattern = patternEl.value;
      if (!pattern) {
        errEl.classList.add('hidden');
        highlightEl.innerHTML = esc(textEl.value);
        countEl.textContent = '';
        matchesEl.innerHTML = '';
        return;
      }
      clearTimeout(timer);
      worker.postMessage({ pattern, flags: readFlags(), text: textEl.value });
      // ReDoS 超时防护:超过 1s 终止并重建 worker
      timer = setTimeout(() => {
        worker.terminate();
        spawn();
        showError(TXT.timeout);
      }, 1000);
    }

    patternEl.addEventListener('input', evaluate);
    textEl.addEventListener('input', evaluate);
    flagBoxes.forEach((b) => b.addEventListener('change', evaluate));
    document.querySelectorAll<HTMLButtonElement>('.tpl-btn').forEach((b) =>
      b.addEventListener('click', () => {
        patternEl.value = b.dataset.pattern!;
        evaluate();
      })
    );

    spawn();
    evaluate();
  </script>
</ToolPageLayout>
