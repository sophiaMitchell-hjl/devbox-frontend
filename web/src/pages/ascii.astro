---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = 'ASCII 码表 - 可搜索的字符/十进制/十六进制对照 | DevBox';
const description =
  '完整可搜索的 ASCII 码表:字符、十进制、十六进制、二进制对照,含控制字符说明。离线可用,浏览器本地渲染。';
const faqs = [
  {
    q: 'ASCII 和 Unicode 什么关系?',
    a: 'ASCII 是最早的 7 位编码(0–127),Unicode 向下兼容它——前 128 个 Unicode 码点与 ASCII 完全一致。',
  },
];
const ctrl: Record<number, string> = {
  0: 'NUL 空', 7: 'BEL 响铃', 8: 'BS 退格', 9: 'TAB 制表', 10: 'LF 换行', 13: 'CR 回车', 27: 'ESC 转义', 32: '空格', 127: 'DEL 删除',
};
const rows = Array.from({ length: 128 }, (_, i) => {
  let ch = ctrl[i];
  if (!ch) ch = i < 32 ? `控制符` : String.fromCharCode(i);
  return { dec: i, hex: i.toString(16).toUpperCase().padStart(2, '0'), bin: i.toString(2).padStart(8, '0'), ch };
});
---

<ToolPageLayout slug="ascii" title={title} description={description} faqs={faqs}>
  <input id="q" type="text" placeholder="搜索:字符 / 十进制 / 十六进制(如 A、65、41)" class="mb-4 w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" />

  <div class="overflow-x-auto rounded-xl border border-zinc-200 dark:border-zinc-800">
    <table class="w-full text-sm">
      <thead class="bg-zinc-50 text-left text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
        <tr><th class="px-3 py-2 font-medium">字符</th><th class="px-3 py-2 font-medium">十进制</th><th class="px-3 py-2 font-medium">十六进制</th><th class="px-3 py-2 font-medium">二进制</th></tr>
      </thead>
      <tbody id="tb" class="divide-y divide-zinc-100 font-mono dark:divide-zinc-800">
        {
          rows.map((r) => (
            <tr class="ascii-row" data-s={`${r.ch} ${r.dec} ${r.hex}`.toLowerCase()}>
              <td class="px-3 py-1.5">{r.ch}</td>
              <td class="px-3 py-1.5 text-violet-600 dark:text-violet-400">{r.dec}</td>
              <td class="px-3 py-1.5 text-zinc-600 dark:text-zinc-300">0x{r.hex}</td>
              <td class="px-3 py-1.5 text-zinc-400">{r.bin}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.ascii-row'));
    q.addEventListener('input', () => {
      const s = q.value.trim().toLowerCase();
      rows.forEach((r) => {
        r.style.display = !s || (r.dataset.s || '').includes(s) ? '' : 'none';
      });
    });
  </script>
</ToolPageLayout>
