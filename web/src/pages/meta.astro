---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = 'Meta 标签长度检测 - Title/Description + SERP 预览 | DevBox';
const description =
  '在线检测网页 title 与 meta description 的字符数和像素宽度,超出搜索引擎截断长度即时提示,并实时预览 Google 搜索结果外观。';
const faqs = [
  {
    q: 'Title 和 Description 多长合适?',
    a: 'Google 按像素宽度截断:标题约 600px(中文约 30 字、英文约 60 字),描述约 920–960px(中文约 76 字、英文约 155–160 字)。控制在此范围内可避免被截断。',
  },
];
const inputCls =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="meta" title={title} description={description} faqs={faqs}>
  <div class="space-y-4">
    <div>
      <label class="mb-1 flex items-center justify-between text-sm font-medium text-zinc-700 dark:text-zinc-300">
        标题 Title <span id="t-stat" class="font-mono text-xs"></span>
      </label>
      <input id="title" type="text" value="DevBox - 开发者在线工具箱" class={inputCls} />
    </div>
    <div>
      <label class="mb-1 flex items-center justify-between text-sm font-medium text-zinc-700 dark:text-zinc-300">
        描述 Description <span id="d-stat" class="font-mono text-xs"></span>
      </label>
      <textarea id="desc" rows="3" class={inputCls}>填参数,出配置与命令,复制即用。Nginx、Docker Compose、Cron、正则等常用工具,浏览器本地计算、免注册。</textarea>
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">URL(仅用于预览)</label>
      <input id="url" type="text" value="https://devbox.nextlink.me" class={inputCls} />
    </div>
  </div>

  <div class="mt-6">
    <p class="mb-2 text-sm font-medium text-zinc-700 dark:text-zinc-300">Google 搜索结果预览</p>
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
      <p id="p-url" class="truncate text-sm text-emerald-700 dark:text-emerald-500"></p>
      <p id="p-title" class="mt-0.5 truncate text-xl text-blue-700 dark:text-blue-400"></p>
      <p id="p-desc" class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"></p>
    </div>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const titleEl = $('title');
    const descEl = $('desc');
    const urlEl = $('url');

    // 用 canvas 估算像素宽度
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d')!;
    function px(text: string, font: string) {
      ctx.font = font;
      return Math.round(ctx.measureText(text).width);
    }

    function stat(el: HTMLElement, text: string, font: string, maxPx: number) {
      const chars = [...text].length;
      const w = px(text, font);
      const ok = w <= maxPx;
      el.textContent = `${chars} 字 · ${w}/${maxPx}px`;
      el.className = 'font-mono text-xs ' + (ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-500');
    }

    function truncatePx(text: string, font: string, maxPx: number) {
      if (px(text, font) <= maxPx) return text;
      let s = text;
      while (s.length && px(s + '…', font) > maxPx) s = s.slice(0, -1);
      return s + '…';
    }

    function render() {
      const t = titleEl.value;
      const d = descEl.value;
      stat(document.getElementById('t-stat')!, t, '20px Arial', 600);
      stat(document.getElementById('d-stat')!, d, '14px Arial', 920);
      document.getElementById('p-url')!.textContent = urlEl.value || 'https://example.com';
      document.getElementById('p-title')!.textContent = truncatePx(t, '20px Arial', 600) || '(标题)';
      document.getElementById('p-desc')!.textContent = truncatePx(d, '14px Arial', 920) || '(描述)';
    }

    [titleEl, descEl, urlEl].forEach((el) => el.addEventListener('input', render));
    render();
  </script>
</ToolPageLayout>
