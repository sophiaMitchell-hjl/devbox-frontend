---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = '密码生成器 - 在线生成高强度随机密码 | DevBox';
const description =
  '在线密码生成器:可选长度与字符集(大小写/数字/符号),基于浏览器安全随机源本地生成,不联网、不记录,一键复制。';
const faqs = [
  {
    q: '这个密码安全吗?会被记录吗?',
    a: '密码使用浏览器的加密安全随机源(crypto.getRandomValues)在本地生成,不发送到任何服务器、也不保存,关闭页面即消失。',
  },
];
---

<ToolPageLayout slug="password" title={title} description={description} faqs={faqs}>
  <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="flex gap-2">
      <input id="out" type="text" readonly class="flex-1 rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-3 font-mono text-lg text-zinc-900 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" />
      <button id="regen" type="button" class="shrink-0 rounded-xl border border-zinc-300 px-4 text-sm dark:border-zinc-700 dark:text-zinc-200" title="重新生成">↻</button>
      <button id="copy" type="button" class="shrink-0 rounded-xl bg-zinc-900 px-5 text-sm font-medium text-white dark:bg-white dark:text-zinc-900">复制</button>
    </div>

    <div class="mt-3 flex items-center gap-2">
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
        <div id="bar" class="h-full w-0 rounded-full transition-all"></div>
      </div>
      <span id="strength" class="w-16 text-right text-xs text-zinc-400"></span>
    </div>

    <div class="mt-5 space-y-4">
      <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">
        <div class="flex items-center justify-between">长度 <span id="len-val" class="font-mono text-zinc-400">16</span></div>
        <input id="len" type="range" min="6" max="64" value="16" class="mt-1 w-full accent-violet-600" />
      </label>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600 dark:text-zinc-300">
        <label class="flex items-center gap-2"><input id="lower" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> 小写 a-z</label>
        <label class="flex items-center gap-2"><input id="upper" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> 大写 A-Z</label>
        <label class="flex items-center gap-2"><input id="digits" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> 数字 0-9</label>
        <label class="flex items-center gap-2"><input id="symbols" type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> 符号 !@#$</label>
        <label class="flex items-center gap-2"><input id="noamb" type="checkbox" class="h-4 w-4 rounded border-zinc-300 accent-violet-600" /> 排除易混字符 (0O1lI)</label>
      </div>
    </div>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const out = $('out');
    const bar = document.getElementById('bar')!;
    const strengthEl = document.getElementById('strength')!;
    const lenVal = document.getElementById('len-val')!;

    function pool() {
      let p = '';
      if ($('lower').checked) p += 'abcdefghijklmnopqrstuvwxyz';
      if ($('upper').checked) p += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if ($('digits').checked) p += '0123456789';
      if ($('symbols').checked) p += '!@#$%^&*()-_=+[]{};:,.<>?';
      if ($('noamb').checked) p = p.replace(/[0O1lI]/g, '');
      return p || 'abcdefghijklmnopqrstuvwxyz';
    }

    function gen() {
      const len = Number($('len').value);
      lenVal.textContent = String(len);
      const p = pool();
      const arr = new Uint32Array(len);
      crypto.getRandomValues(arr);
      let s = '';
      for (let i = 0; i < len; i++) s += p[arr[i] % p.length];
      out.value = s;
      // 强度:基于熵 log2(pool)*len
      const bits = Math.round(Math.log2(p.length) * len);
      let label = '弱', color = '#ef4444', w = 33;
      if (bits >= 128) { label = '极强'; color = '#10b981'; w = 100; }
      else if (bits >= 80) { label = '强'; color = '#22c55e'; w = 80; }
      else if (bits >= 60) { label = '中'; color = '#f59e0b'; w = 55; }
      bar.style.width = w + '%';
      bar.style.background = color;
      strengthEl.textContent = `${label} ${bits}位`;
    }

    ['len', 'lower', 'upper', 'digits', 'symbols', 'noamb'].forEach((id) => $(id).addEventListener('input', gen));
    document.getElementById('regen')!.addEventListener('click', gen);
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(out.value);
    });
    gen();
  </script>
</ToolPageLayout>
