---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getTool } from '../../lib/tools';
import { slugOf } from '../../lib/articles';

export async function getStaticPaths() {
  const all = await getCollection('articles', (e) => e.data.tool === 'regex');
  const siblings = all.map((e) => ({
    slug: slugOf(e.id),
    title: e.data.title,
    type: e.data.type,
  }));
  return all.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry, siblings },
  }));
}

const { entry, siblings } = Astro.props;
const { Content } = await render(entry);
const tool = getTool('regex')!;
---

<ArticleLayout
  slug={slugOf(entry.id)}
  title={entry.data.title}
  description={entry.data.description}
  seoTitle={entry.data.seoTitle}
  type={entry.data.type}
  updated={entry.data.updated}
  faqs={entry.data.faqs}
  toolSlug={tool.slug}
  toolShort={tool.short}
  toolTitle={tool.title}
  siblings={siblings}
>
  <Content />
</ArticleLayout>
