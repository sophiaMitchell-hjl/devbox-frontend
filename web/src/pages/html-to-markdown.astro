---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = 'HTML 转 Markdown - 在线把网页代码转成 MD | DevBox';
const description =
  '在线 HTML 转 Markdown:粘贴 HTML 即时转成 Markdown,保留标题、列表、链接、代码块等结构,复制即用。浏览器本地转换。';
const faqs = [
  {
    q: '会保留哪些格式?',
    a: '标题、加粗/斜体、列表、链接、图片、行内代码与代码块、引用等常见结构都会转换;复杂的表格与内联样式可能需要手工微调。',
  },
];
const areaCls =
  'w-full h-80 rounded-xl border border-zinc-300 bg-zinc-50 p-4 font-mono text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="html-to-markdown" title={title} description={description} faqs={faqs}>
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">HTML 输入</label>
      <textarea id="in" class={areaCls} data-clear-target="out" spellcheck="false" placeholder="示例输入:&lt;h1&gt;标题&lt;/h1&gt;&lt;p&gt;正文&lt;/p&gt;"></textarea>
    </div>
    <div>
      <div class="mb-1 flex items-center justify-between">
        <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">Markdown 输出</label>
        <button id="copy" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">复制</button>
      </div>
      <textarea id="out" class={areaCls} readonly placeholder="示例输出:# 标题"></textarea>
    </div>
  </div>

  <script>
    import TurndownService from 'turndown';
    const td = new TurndownService({ headingStyle: 'atx', codeBlockStyle: 'fenced', bulletListMarker: '-' });
    const inEl = document.getElementById('in') as HTMLTextAreaElement;
    const outEl = document.getElementById('out') as HTMLTextAreaElement;

    function run() {
      try {
        outEl.value = td.turndown(inEl.value);
      } catch {
        outEl.value = '';
      }
    }
    inEl.addEventListener('input', run);
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(outEl.value);
    });
    run();
  </script>
</ToolPageLayout>
