---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = 'Open Graph 预览 - 社交分享卡片预览与标签生成 | DevBox';
const description =
  '在线 Open Graph 预览:填写标题、描述、图片等,实时预览网页分享到社交平台的卡片效果,并一键生成 og:/twitter: 标签代码。';
const faqs = [
  {
    q: 'og:image 有什么尺寸建议?',
    a: '推荐 1200×630(约 1.91:1),大图卡片显示效果最好;图片需可公开访问的绝对 URL。',
  },
];
const inputCls =
  'w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 outline-none focus:border-violet-400 dark:border-zinc-700 dark:bg-zinc-950 dark:text-white';
---

<ToolPageLayout slug="og" title={title} description={description} faqs={faqs}>
  <div class="grid gap-6 md:grid-cols-2">
    <div class="space-y-3">
      <div><label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">标题 og:title</label><input id="t" type="text" value="DevBox - 开发者在线工具箱" class={inputCls} /></div>
      <div><label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">描述 og:description</label><textarea id="d" rows="2" class={inputCls}>填参数,出配置与命令,复制即用。</textarea></div>
      <div><label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">图片 og:image</label><input id="img" type="text" placeholder="https://…/cover.png" class={inputCls} /></div>
      <div><label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">网址 og:url</label><input id="u" type="text" value="https://devbox.nextlink.me" class={inputCls} /></div>
      <div><label class="mb-1 block text-sm font-medium text-zinc-700 dark:text-zinc-300">站点名 og:site_name</label><input id="s" type="text" value="DevBox" class={inputCls} /></div>
    </div>

    <div>
      <p class="mb-2 text-sm font-medium text-zinc-700 dark:text-zinc-300">卡片预览</p>
      <div class="overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-800">
        <div id="p-img" class="flex h-44 items-center justify-center bg-zinc-100 text-xs text-zinc-400 dark:bg-zinc-800">未设置 og:image</div>
        <div class="bg-white p-3 dark:bg-zinc-900">
          <p id="p-domain" class="text-xs uppercase text-zinc-400"></p>
          <p id="p-title" class="mt-0.5 truncate font-semibold text-zinc-900 dark:text-white"></p>
          <p id="p-desc" class="mt-0.5 line-clamp-2 text-sm text-zinc-500 dark:text-zinc-400"></p>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">标签代码</span>
        <button id="copy" type="button" class="text-xs font-medium text-violet-600 dark:text-violet-400">复制</button>
      </div>
      <pre class="mt-1 rounded-xl bg-zinc-900 p-4 font-mono text-xs whitespace-pre-wrap break-words text-zinc-100"><code id="out"></code></pre>
    </div>
  </div>

  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const pImg = document.getElementById('p-img')!;
    const out = document.getElementById('out')!;

    function esc(s: string) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function domain(u: string) {
      try { return new URL(u).hostname; } catch { return u; }
    }

    function render() {
      const t = $('t').value, d = $('d').value, img = $('img').value, u = $('u').value, s = $('s').value;
      document.getElementById('p-title')!.textContent = t || '(标题)';
      document.getElementById('p-desc')!.textContent = d || '(描述)';
      document.getElementById('p-domain')!.textContent = domain(u);
      if (img) {
        pImg.innerHTML = `<img src="${esc(img)}" alt="" class="h-full w-full object-cover" onerror="this.parentElement.textContent='图片无法加载'" />`;
      } else {
        pImg.textContent = '未设置 og:image';
      }
      const tags = [
        `<meta property="og:title" content="${esc(t)}">`,
        `<meta property="og:description" content="${esc(d)}">`,
        img ? `<meta property="og:image" content="${esc(img)}">` : '',
        `<meta property="og:url" content="${esc(u)}">`,
        `<meta property="og:site_name" content="${esc(s)}">`,
        `<meta property="og:type" content="website">`,
        `<meta name="twitter:card" content="summary_large_image">`,
        `<meta name="twitter:title" content="${esc(t)}">`,
        `<meta name="twitter:description" content="${esc(d)}">`,
        img ? `<meta name="twitter:image" content="${esc(img)}">` : '',
      ].filter(Boolean);
      out.textContent = tags.join('\n');
    }

    ['t', 'd', 'img', 'u', 's'].forEach((id) => $(id).addEventListener('input', render));
    document.getElementById('copy')!.addEventListener('click', async () => {
      await navigator.clipboard.writeText(out.textContent || '');
    });
    render();
  </script>
</ToolPageLayout>
