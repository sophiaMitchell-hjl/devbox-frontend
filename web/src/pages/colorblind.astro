---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';

const title = '色盲模拟 - 模拟颜色在色觉障碍下的效果 | DevBox';
const description =
  '在线色盲模拟:输入颜色,模拟它在红色盲、绿色盲、蓝色盲等色觉障碍下的显示效果,辅助无障碍配色。浏览器本地计算。';
const faqs = [
  {
    q: '为什么要做色盲模拟?',
    a: '约 8% 的男性有某种色觉障碍。用只靠颜色区分的信息(如红/绿状态)对他们可能难以分辨,模拟能帮你提前发现问题。',
  },
];
const types = [
  { key: 'normal', label: '正常' },
  { key: 'protanopia', label: '红色盲' },
  { key: 'deuteranopia', label: '绿色盲' },
  { key: 'tritanopia', label: '蓝色盲' },
  { key: 'achromatopsia', label: '全色盲' },
];
---

<ToolPageLayout slug="colorblind" title={title} description={description} faqs={faqs}>
  <div class="flex items-center gap-3">
    <input id="color" type="color" value="#e11d48" class="h-12 w-20 cursor-pointer rounded border border-zinc-300 bg-transparent dark:border-zinc-700" />
    <input id="hex" type="text" value="#e11d48" class="w-32 rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-sm dark:border-zinc-700 dark:bg-zinc-950 dark:text-white" />
  </div>

  <div id="grid" class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    {
      types.map((t) => (
        <div class="text-center">
          <div id={`c-${t.key}`} class="h-24 rounded-xl border border-zinc-200 dark:border-zinc-800" />
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">{t.label}</p>
          <p id={`v-${t.key}`} class="font-mono text-xs text-zinc-400" />
        </div>
      ))
    }
  </div>

  <script>
    const color = document.getElementById('color') as HTMLInputElement;
    const hex = document.getElementById('hex') as HTMLInputElement;

    // 简化的色盲变换矩阵(sRGB 近似)
    const M: Record<string, number[]> = {
      normal: [1, 0, 0, 0, 1, 0, 0, 0, 1],
      protanopia: [0.567, 0.433, 0, 0.558, 0.442, 0, 0, 0.242, 0.758],
      deuteranopia: [0.625, 0.375, 0, 0.7, 0.3, 0, 0, 0.3, 0.7],
      tritanopia: [0.95, 0.05, 0, 0, 0.433, 0.567, 0, 0.475, 0.525],
      achromatopsia: [0.299, 0.587, 0.114, 0.299, 0.587, 0.114, 0.299, 0.587, 0.114],
    };
    const clamp = (n: number) => Math.max(0, Math.min(255, Math.round(n)));
    const toHex = (n: number) => clamp(n).toString(16).padStart(2, '0');

    function apply(rgb: number[], m: number[]) {
      return [
        rgb[0] * m[0] + rgb[1] * m[1] + rgb[2] * m[2],
        rgb[0] * m[3] + rgb[1] * m[4] + rgb[2] * m[5],
        rgb[0] * m[6] + rgb[1] * m[7] + rgb[2] * m[8],
      ];
    }

    function run(h: string) {
      const m = h.replace('#', '');
      if (!/^[0-9a-fA-F]{6}$/.test(m)) return;
      const rgb = [0, 2, 4].map((i) => parseInt(m.slice(i, i + 2), 16));
      for (const key of Object.keys(M)) {
        const [r, g, b] = apply(rgb, M[key]);
        const hx = `#${toHex(r)}${toHex(g)}${toHex(b)}`;
        (document.getElementById(`c-${key}`)!).style.background = hx;
        document.getElementById(`v-${key}`)!.textContent = hx;
      }
    }

    color.addEventListener('input', () => { hex.value = color.value; run(color.value); });
    hex.addEventListener('input', () => {
      let v = hex.value.trim(); if (!v.startsWith('#')) v = '#' + v;
      if (/^#[0-9a-fA-F]{6}$/.test(v)) { color.value = v; run(v); }
    });
    run(color.value);
  </script>
</ToolPageLayout>
