---
import { useUI } from '../i18n/ui';
import { localePath, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useUI(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-200/70 dark:border-zinc-800/70">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:text-zinc-400"
  >
    <div class="flex items-center gap-2">
      <span class="inline-block h-4 w-4 rounded bg-gradient-to-br from-indigo-500 to-violet-500"></span>
      <span>DevBox · {t('site.tagline')}</span>
    </div>
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href={localePath('/about', lang)} class="transition-colors hover:text-zinc-900 dark:hover:text-white">{t('footer.about')}</a>
      <a href={localePath('/privacy', lang)} class="transition-colors hover:text-zinc-900 dark:hover:text-white">{t('footer.privacy')}</a>
      <a href={localePath('/terms', lang)} class="transition-colors hover:text-zinc-900 dark:hover:text-white">{t('footer.terms')}</a>
      <span>© {year}</span>
    </nav>
  </div>
</footer>
