---
import type { ResolvedTool } from '../lib/tools';
import { categoryLabels } from '../lib/tools';
import { localePath, type Lang } from '../i18n';
const { tool, lang } = Astro.props as { tool: ResolvedTool; lang: Lang };
const live = tool.status === 'live';
const Tag = live ? 'a' : 'div';
const labels = categoryLabels(lang);
const t = {
  open: lang === 'en' ? 'Open →' : '打开 →',
  soon: lang === 'en' ? 'Coming soon' : '即将上线',
};
---

<Tag
  {...live ? { href: localePath(`/${tool.slug}`, lang) } : {}}
  class:list={[
    'group relative flex flex-col rounded-2xl border p-6 transition-all duration-200',
    live
      ? 'cursor-pointer border-zinc-200 bg-white hover:-translate-y-1 hover:border-violet-300 hover:shadow-xl hover:shadow-violet-500/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-violet-700'
      : 'border-dashed border-zinc-200 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-900/40',
  ]}
>
  <div class="mb-3 flex items-center justify-between">
    <span
      class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400"
    >
      {labels[tool.category]}
    </span>
    {
      live ? (
        <span class="text-xs font-medium text-violet-500 opacity-0 transition-opacity group-hover:opacity-100">
          {t.open}
        </span>
      ) : (
        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-600 dark:bg-amber-500/10 dark:text-amber-400">
          {t.soon}
        </span>
      )
    }
  </div>
  <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">{tool.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{tool.desc}</p>
  <p class="mt-4 text-xs text-zinc-400 dark:text-zinc-500">{tool.stage}</p>
</Tag>
